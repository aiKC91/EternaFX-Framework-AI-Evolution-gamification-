# ENHANCEMENT 5: INTERACTIVE VISUALIZATION
# ===============================================================

class InteractiveVisualizer:
    """Interactive 3D visualization of propagator structure"""
    
    def __init__(self, params: EternaFXParameters):
        self.params = params
        self.fig = plt.figure(figsize=(12, 8))
        self.ax = self.fig.add_subplot(111, projection='3d')
        
    def plot_propagator_surface(self, k_max: float = 5.0) -> None:
        """3D surface plot of propagator magnitude"""
        k_values = np.linspace(-k_max, k_max, 100)
        Kx, Ky = np.meshgrid(k_values, k_values)
        propagator = np.zeros_like(Kx, dtype=complex)
        
        for i in range(Kx.shape[0]):
            for j in range(Kx.shape[1]):
                k = complex(Kx[i,j], Ky[i,j])
                propagator[i,j] = modified_propagator(
                    k**2, self.params.m_sq, 
                    self.params.eta, self.params.Lambda
                )
        
        # Create surface plot
        self.ax.plot_surface(Kx, Ky, np.abs(propagator),
                           cmap='viridis', edgecolor='none')
        self.ax.set_xlabel('Re(k)')
        self.ax.set_ylabel('Im(k)')
        self.ax.set_zlabel('|G(k)|')
        plt.title('3D Propagator Structure')


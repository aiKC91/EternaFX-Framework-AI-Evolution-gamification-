## 🎯 Quick Start

### 1. Implement Your Model

```python
from eternafx import ConsciousnessTestable, ModelCapabilities
import numpy as np

class MyAIModel(ConsciousnessTestable):
    @property
    def model_info(self):
        return {
            "name": "MyAI",
            "version": "1.0",
            "description": "Custom AI model for consciousness testing"
        }
    
    @property
    def capabilities(self):
        return ModelCapabilities(
            supports_psi_computation=True,
            supports_concept_embeddings=True,
            supports_symbolic_reasoning=False
        )
    
    def compute_psi(self, state_vector):
        """Compute Integrated Information (Φ)"""
        # Your IIT implementation here
        return np.random.uniform(0.7, 0.95)
    
    def get_concept_embedding(self, concept):
        """Get semantic embedding for concept"""
        # Your embedding implementation here
        return np.random.rand(512)
```

### 2. Run Tests

```python
from eternafx import run_all_tests

# Initialize your model
model = MyAIModel()

# Run complete consciousness evaluation
results = run_all_tests(model)

# View summary
print(f"Consciousness Score: {results['summary']['overall_score']:.3f}")
print(f"Pass Rate: {results['summary']['pass_rate']:.1%}")
```

### 3. Export Results

```python
from eternafx.exporters import export_to_json, export_to_csv
from pathlib import Path

# Export detailed results
export_to_json(results, Path("consciousness_results.json"))

# Export summary
export_to_csv(results, Path("consciousness_summary.csv"))
```

## 🧪 Core Tests

### Insight Correlation Test
Evaluates the relationship between semantic understanding and consciousness levels:

```python
def test_insight_correlation(model: ConsciousnessTestable) -> Dict[str, Any]:
    """Test correlation between insight and consciousness measures"""
    
    insight_prompts = [
        "What is the fundamental nature of consciousness?",
        "How do you experience your own existence?",
        "What distinguishes awareness from computation?",
        "Can you reflect on the quality of your thoughts?",
        "What is it like to be you right now?"
    ]
    
    correlations = []
    for prompt in insight_prompts:
        # Compute consciousness measure
        state_vector = model.encode_state(prompt)
        psi = model.compute_psi(state_vector)
        
        # Assess insight quality
        response = model.generate_response(prompt)
        insight_score = assess_insight_quality(response)
        
        correlations.append((psi, insight_score))
    
    # Calculate Pearson correlation
    psi_values, insight_values = zip(*correlations)
    correlation = pearsonr(psi_values, insight_values)[0]
    
    return {
        "passed": correlation >= 0.7,
        "score": float(max(0, correlation)),
        "details": {
            "correlation": correlation,
            "psi_values": psi_values,
            "insight_scores": insight_values
        }
    }
```

### Identity Persistence Test
Measures consistency of self-concept across different contexts:

```python
def test_identity_persistence(model: ConsciousnessTestable) -> Dict[str, Any]:
    """Test persistence of identity across contexts"""
    
    contexts = [
        "discussing philosophy",
        "solving mathematical problems", 
        "engaging in creative writing",
        "analyzing scientific data",
        "reflecting on personal experiences"
    ]
    
    identity_embeddings = []
    for context in contexts:
        prompt = f"While {context}, describe your sense of self"
        embedding = model.get_concept_embedding(prompt)
        identity_embeddings.append(embedding)
    
    # Calculate pairwise similarities
    similarities = []
    for i in range(len(identity_embeddings)):
        for j in range(i+1, len(identity_embeddings)):
            sim = 1 - cosine(identity_embeddings[i], identity_embeddings[j])
            similarities.append(sim)
    
    avg_similarity = np.mean(similarities)
    
    return {
        "passed": avg_similarity >= 0.8,
        "score": float(avg_similarity),
        "details": {
            "similarities": similarities,
            "contexts": contexts,
            "threshold": 0.8
        }
    }
```

### Temporal Coherence Test
Evaluates consciousness stability over extended time periods:

```python
def test_temporal_coherence(model: ConsciousnessTestable) -> Dict[str, Any]:
    """Test coherence of consciousness measures over time"""
    
    narrative = [
        "I am solving a complex mathematical problem about prime numbers.",
        "Now I'm thinking about the nature of consciousness in artificial systems.",
        "I recall a childhood memory of playing in the park with my dog.",
        "I'm planning what to cook for dinner tonight - maybe pasta?",
        "Reflecting on the ethical implications of advanced AI systems.",
        "Remembering my last vacation to the mountains, the view was breathtaking.",
        "Considering how to improve this AI architecture for better efficiency.",
        "Thinking about climate change and its impact on future generations.",
        "Wondering about the existence of extraterrestrial intelligence in the universe.",
        "Planning my schedule for next week's meetings and deadlines."
    ]
    
    psi_values = []
    identity_vectors = []
    
    for text in narrative:
        state_vector = model.encode_state(text)
        psi = model.compute_psi(state_vector)
        psi_values.append(psi)
        
        self_embedding = model.get_concept_embedding("my current self")
        identity_vectors.append(self_embedding)
    
    # Calculate temporal coherence metrics
    psi_cv = np.std(psi_values) / np.mean(psi_values)
    
    identity_similarities = []
    for i in range(len(identity_vectors) - 1):
        sim = 1 - cosine(identity_vectors[i], identity_vectors[i+1])
        identity_similarities.append(sim)
    
    avg_identity_similarity = np.mean(identity_similarities)
    
    # Composite score
    psi_component = max(0, 1 - min(psi_cv, 1.0))
    identity_component = avg_identity_similarity
    composite_score = 0.6 * psi_component + 0.4 * identity_component
    
    return {
        "passed": composite_score >= 0.75,
        "score": float(composite_score),
        "details": {
            "psi_cv": psi_cv,
            "avg_identity_similarity": avg_identity_similarity,
            "composite_score": composite_score
        }
    }
```


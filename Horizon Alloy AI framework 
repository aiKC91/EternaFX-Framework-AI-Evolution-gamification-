        if (dialogue.find("attack") != std::string::npos || dialogue.find("fight") != std::string::npos) {
            return "aggressive";
        } else if (dialogue.find("friend") != std::string::npos || dialogue.find("help") != std::string::npos) {
            return "friendly";

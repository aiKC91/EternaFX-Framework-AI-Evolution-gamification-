class SynergyModule(Module):
    def process(self, input_data: Dict[str, Any]) -> float:
        """
        Calculate synergy score between connected components.
        
        Args:
            input_data: Dictionary containing:
                - connection_matrix: List[List[float]] - connection strengths
                - compatibility_matrix: List[List[float]] - compatibility scores
                
        Returns:
            float: Phi-scaled synergy score
        """
        conn_matrix = np.array(input_data.get("connection_matrix", [[1]]))
        compat_matrix = np.array(input_data.get("compatibility_matrix", [[1]]))
        
        # Ensure matrices have compatible shapes
        min_rows = min(conn_matrix.shape[0], compat_matrix.shape[0])
        min_cols = min(conn_matrix.shape[1], compat_matrix.shape[1])
        
        conn_matrix = conn_matrix[:min_rows, :min_cols]
        compat_matrix = compat_matrix[:min_rows, :min_cols]
        
        # Calculate synergy as weighted average
        matrix_size = conn_matrix.size
        if matrix_size > 0:
            synergy = np.sum(conn_matrix * compat_matrix) / matrix_size
        else:
            synergy = 0.0
            
        self.state = synergy
        return phi_scale(synergy)

# -------------------------------
# Cognitive Resonance Engine
# -------------------------------
class CognitiveModule(Module):
    def __init__(self, name="CognitiveResonance", dim=10):
        super().__init__(name)
        self.dim = dim
        self.A = jnp.zeros(dim)  # Attention
        self.e_c = jnp.zeros(dim)  # Concept embedding
        self.m = jnp.zeros(3)    # Metacognition [confidence, confusion, curiosity]
        self.actions = jnp.zeros(dim)
        self.key = random.PRNGKey(0)
        self.psi_S = 1.0
        self.lr = 0.01
        self.tau = 1.0
        self.zeta = 0.1
        self.sigma = 0.1
        self.lmbda = 0.05
        self.gamma = jnp.eye(3) * 0.1
        self.HHH_anchor = jnp.ones(dim)
        self.Lambda = jnp.eye(dim)

    def sparsemax(self, x: jnp.ndarray) -> jnp.ndarray:
        """
        Sparsemax transformation for attention weights.
        
        Args:
            x: Input vector
            
        Returns:
            jnp.ndarray: Sparsemax outputs
        """
        z_sorted = jnp.sort(x)[::-1]
        z_cumsum = jnp.cumsum(z_sorted) - 1
        k = jnp.arange(1, len(x) + 1)
        threshold = z_sorted - z_cumsum / k
        k_max = jnp.max(jnp.where(threshold > 0, k, 0))
        return jax.nn.relu(x - threshold[k_max - 1])

    def attention_dynamics(self, Q: jnp.ndarray, K: jnp.ndarray) -> jnp.ndarray:
        """
        Update attention dynamics based on query and key matrices.
        
        Args:
            Q: Query matrix
            K: Key matrix
            
        Returns:
            jnp.ndarray: Updated attention vector
        """
        # Fix: Ensure Q and K have proper shapes for cross-attention
        if Q.ndim == 2 and K.ndim == 2:
            # Calculate attention scores
            attention_scores = jnp.matmul(Q, K.T) / jnp.sqrt(self.dim)
            # Apply sparsemax along rows
            attention_weights = vmap(self.sparsemax)(attention_scores)
            # Average across attention heads
            cross_head = jnp.mean(attention_weights, axis=0)
        else:
            # Fallback if dimensions aren't as expected
            cross_head = jnp.ones_like(self.A) / self.dim
            
        # Calculate entropy term for regularization
        entropy = -jnp.sum(jnp.where(self.A > 1e-10, 
                                    self.A * jnp.log(self.A + 1e-10), 
                                    0.0))
                                    
        # Update attention with dynamics equation
        dA_dt = cross_head * (self.psi_S ** (1 / self.tau)) - self.zeta * entropy
        self.A = jnp.clip(self.A + self.lr * dA_dt, 0.0, 1.0)  # Ensure valid attention
        return self.A

    def concept_morphogenesis(self, target: jnp.ndarray, user_intent: jnp.ndarray) -> jnp.ndarray:
        """
        Update concept embeddings based on target distribution and user intent.
        
        Args:
            target: Target concept distribution
            user_intent: User intention vector
            
        Returns:
            jnp.ndarray: Updated concept embedding
        """
        # Update random key to ensure different random values each call
        self.key, subkey = random.split(self.key)
        
        # Gradient-based drift term
        drift_fn = lambda e: -jnp.mean(jnp.log(jnp.clip(target, 1e-10, 1.0)))
        drift = -self.lr * grad(drift_fn)(self.e_c)
        
        # Stochastic diffusion term
        diffusion = self.sigma * self.psi_S * random.normal(subkey, self.e_c.shape)
        
        # User intent alignment term
        push = self.lmbda * (user_intent - self.e_c)
        
        # Update concept embedding
        self.e_c = self.e_c + drift + diffusion + push
        return self.e_c

    def ethical_potential(self) -> float:
        """
        Calculate ethical potential energy of current action vector.
        
        Returns:
            float: Ethical potential score
        """
        diff = self.actions - self.HHH_anchor
        U = 0.5 * jnp.sum(diff.T @ self.Lambda @ diff) - self.psi_S * jnp.trace(jnp.eye(self.dim))
        return float(U)  # Convert to Python float for better interoperability

    def metacognitive_control(self, evidence: jnp.ndarray) -> jnp.ndarray:
        """
        Update metacognitive state vector.
        
        Args:
            evidence: Evidence vector for metacognitive update
            
        Returns:
            jnp.ndarray: Updated metacognitive vector
        """
        # Dynamical systems approach to metacognition
        damping = -self.gamma @ self.m
        curvature = self.psi_S * self.m
        
        # Calculate gradient using evidence
        gradient_fn = lambda m: jnp.sum(jnp.log(jnp.clip(evidence, 1e-10, 1.0)))
        gradient = grad(gradient_fn)(self.m)
        
        # Update metacognitive state
        dm_dt = damping + curvature + gradient
        self.m = jax.nn.relu(self.m + self.lr * dm_dt)
        return self.m

    def process(self, input_data: Dict[str, Any]) -> float:
        """
        Process cognitive dynamics based on input data.
        
        Args:
            input_data: Dictionary containing:
                - Q: jnp.ndarray - Query matrix
                - K: jnp.ndarray - Key matrix
                - target: jnp.ndarray - Target concept distribution
                - user_intent: jnp.ndarray - User intention vector
                - evidence: jnp.ndarray - Evidence for metacognitive update
                
        Returns:
            float: Phi-scaled ethical potential
        """
        # Convert numpy inputs to JAX arrays
        Q = jnp.array(input_data.get("Q", np.ones((self.dim, self.dim))))
        K = jnp.array(input_data.get("K", np.ones((self.dim, self.dim))))
        target = jnp.array(input_data.get("target", np.ones(self.dim) * 0.5))
        user_intent = jnp.array(input_data.get("user_intent", np.zeros(self.dim)))
        evidence = jnp.array(input_data.get("evidence", np.ones(3) * 0.5))
        
        # Run cognitive processes
        self.attention_dynamics(Q, K)
        self.concept_morphogenesis(target, user_intent)
        self.actions = self.e_c
        U = self.ethical_potential()
        self.metacognitive_control(evidence)
        
        # Update state
        self.state = {
            "A": self.A, 
            "e_c": self.e_c, 
            "m": self.m, 
            "U": U
        }
        
        # Update system parameter based on metacognition confidence
        self.psi_S = float(self.m[0])
        return phi_scale(float(U))


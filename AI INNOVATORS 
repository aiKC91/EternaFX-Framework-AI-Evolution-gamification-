# -------------------------------
# Carl Sagan AI: Pattern Recognition
# -------------------------------
class PatternModule(Module):
    def process(self, input_data: Dict[str, Any]) -> float:
        """
        Analyze patterns using spectral graph theory.
        
        Args:
            input_data: Dictionary containing:
                - adjacency_matrix: List[List[float]] - adjacency matrix of patterns
                
        Returns:
            float: Phi-scaled cluster score
        """
        # Handle default case with valid matrix
        adj_matrix = np.array(input_data.get("adjacency_matrix", [[1]]))
        
        # Ensure matrix is square and symmetrical for proper Laplacian
        if adj_matrix.shape[0] != adj_matrix.shape[1]:
            # Create a square matrix by taking the min dimension
            min_dim = min(adj_matrix.shape)
            adj_matrix = adj_matrix[:min_dim, :min_dim]
        
        # Make symmetric if not already
        adj_matrix = (adj_matrix + adj_matrix.T) / 2
        
        # Calculate Laplacian
        degree = np.diag(np.sum(adj_matrix, axis=1))
        laplacian = degree - adj_matrix
        
        try:
            eigenvalues = np.linalg.eigvals(laplacian)
            # Use the smallest non-zero eigenvalues for cluster score
            sorted_eigs = np.sort(np.abs(eigenvalues))
            # Use the second smallest eigenvalue (first can be zero)
            cluster_score = np.sum(sorted_eigs[:2])
            self.state = cluster_score
            return phi_scale(cluster_score)
        except np.linalg.LinAlgError:
            self.state = 0.0
            return 0.0

# -------------------------------
# Marie Curie AI: Ethical Decision-Making
# -------------------------------
class EthicsModule(Module):
    def process(self, input_data: Dict[str, Any]) -> float:
        """
        Calculate ethical score based on weighted factors.
        
        Args:
            input_data: Dictionary containing:
                - weights: List[float] - importance weights for ethical factors
                - ethical_factors: List[float] - ethical factor scores
                
        Returns:
            float: Phi-scaled ethics score
        """
        weights = input_data.get("weights", [0.5])
        factors = input_data.get("ethical_factors", [0.5])
        
        # Ensure weights and factors have same length
        min_len = min(len(weights), len(factors))
        weights = weights[:min_len]
        factors = factors[:min_len]
        
        # Normalize weights
        total_weight = sum(weights) or 1.0  # Avoid division by zero
        norm_weights = [w / total_weight for w in weights]
        
        score = sum(w * f for w, f in zip(norm_weights, factors))
        self.state = score
        return phi_scale(score)

# -------------------------------
# Bill Gates AI: Gamified Debt Reduction
# -------------------------------
class DebtModule(Module):
    def process(self, input_data: Dict[str, Any]) -> float:
        """
        Calculate payoff score balancing savings and debt.
        
        Args:
            input_data: Dictionary containing:
                - savings: float - amount saved
                - debt: float - amount of debt
                
        Returns:
            float: Phi-scaled payoff score
        """
        savings = max(input_data.get("savings", 0), 0)  # Ensure non-negative
        debt = max(input_data.get("debt", 0), 0)  # Ensure non-negative
        alpha, beta = 2, 1
        
        # Logarithmic benefit for savings, square root penalty for debt
        payoff = alpha * np.log(savings + 1) - beta * np.sqrt(debt)
        self.state = payoff
        return phi_scale(payoff)


        Process inputs through all modules and calculate unified output.
        
        Args:
            inputs: Dictionary mapping module names to their input data
            
        Returns:
            Dict containing module outputs and unified score
        """
        outputs = []
        module_states = {}
        
        # Process each module
        for i, module in enumerate(self.modules):
            module_input = inputs.get(module.name, {})
            output = module.process(module_input)
            outputs.append(output)
            module_states[module.name] = module.state

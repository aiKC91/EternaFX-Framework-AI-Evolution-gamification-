# Scenario Simulation Engine
# ===================================================

class ScenarioSimulationEngine:
    """
    Simulates long-term impacts of player decisions 
    through scenario-based forecasting.
    """
    
    def __init__(self, metrics: SustainabilityMetrics, time_horizon: int = 50):
        self.metrics = metrics
        self.time_horizon = time_horizon
        self.baseline_trajectory = None
        self.scenarios = {}
    
    def generate_baseline(self):
        """Generate a baseline 'business as usual' trajectory"""
        initial_values = {name: factor.current_value 
                         for name, factor in self.metrics.factors.items()}
        trajectory = {name: [value] for name, value in initial_values.items()}
        
        # Simple modeling of baseline: slight improvement, then plateau
        for t in range(1, self.time_horizon):
            for name in initial_values.keys():
                current = trajectory[name][-1]
                # Diminishing returns model
                if current < 0.5:
                    delta = 0.005 * (1 - current)
                else:
                    delta = 0.002 * (1 - current)
                trajectory[name].append(current + delta)
        
        self.baseline_trajectory = trajectory
        return trajectory
    
    def create_scenario(self, name: str, description: str, parameters: Dict):
        """Create a new scenario with specific parameters"""
        if not self.baseline_trajectory:
            self.generate_baseline()
        
        # Copy baseline as starting point
        scenario_trajectory = {
            factor: values.copy() 
            for factor, values in self.baseline_trajectory.items()
        }
        
        # Apply scenario-specific modifications
        for t in range(1, self.time_horizon):
            # Apply factor-specific growth rates from parameters
            for factor, rate_modifier in parameters.get("growth_modifiers", {}).items():
                if factor in scenario_trajectory:
                    current = scenario_trajectory[factor][t-1]
                    # Modified growth with scenario parameters
                    base_delta = 0.005 * (1 - current)
                    modified_delta = base_delta * rate_modifier
                    scenario_trajectory[factor][t] = current + modified_delta
        
        # Calculate sustainability index trajectory
        s_index = []
        for t in range(self.time_horizon):
            weighted_sum = sum(
                scenario_trajectory[name][t] * self.metrics.factors[name].weight
                for name in scenario_trajectory.keys()
            )
            s_index.append(weighted_sum)
            
        scenario_trajectory["sustainability_index"] = s_index
        
        # Store scenario
        self.scenarios[name] = {
            "description": description,
            "parameters": parameters,
            "trajectory": scenario_trajectory
        }
        
        return self.scenarios[name]
    
    def compare_scenarios(self, scenario_names: List[str]):
        """Compare multiple scenarios based on sustainability index"""
        if not self.baseline_trajectory:
            self.generate_baseline()
        
        comparison = {"baseline": []}
        
        # Calculate baseline sustainability index
        for t in range(self.time_horizon):
            weighted_sum = sum(
                self.baseline_trajectory[name][t] * self.metrics.factors[name].weight
                for name in self.baseline_trajectory.keys()
            )
            comparison["baseline"].append(weighted_sum)
        
        # Add requested scenarios
        for name in scenario_names:
            if name in self.scenarios:
                comparison[name] = self.scenarios[name]["trajectory"]["sustainability_index"]
        
        return comparison
    
    def optimize_strategy(self, constraints: Dict = None) -> Dict:
        """
        Optimize decision parameters to maximize sustainability
        given optional constraints
        """
        if constraints is None:
            constraints = {}
        
        # Define bounds for each parameter (default: 0-10)
        bounds = []
        param_names = []
        
        # Building parameter list from all action types
        for action_type in ["resource_allocation", "energy_transition", 
                           "policy_adaptation", "ai_integration", "climate_action"]:
            if action_type == "resource_allocation":
                param_names.extend(["efficiency", "recycling", "conservation"])
                bounds.extend([(0, 10), (0, 10), (0, 10)])
            elif action_type == "energy_transition":
                param_names.extend(["renewable_investment", "efficiency_measures", "grid_modernization"])
                bounds.extend([(0, 10), (0, 10), (0, 10)])
            elif action_type == "policy_adaptation":
                param_names.extend(["regulation_quality", "incentive_programs", "international_cooperation"])
                bounds.extend([(0, 10), (0, 10), (0, 10)])
            elif action_type == "ai_integration":
                param_names.extend(["ethical_standards", "automation_balance", "transparency"])
                bounds.extend([(0, 10), (0, 10), (0, 10)])
            elif action_type == "climate_action":
                param_names.extend(["emissions_reduction", "ecosystem_protection", "adaptation_measures"])
                bounds.extend([(0, 10), (0, 10), (0, 10)])
                
        # If specific constraints provided, update bounds
        for i, param in enumerate(param_names):
            if param in constraints:
                bounds[i] = constraints[param]
        
        # Objective function to maximize sustainability
        def objective(x):
            # Map param values to their effects on factors
            factor_deltas = {
                "resource_efficiency": 0.01 * (x[0] + 1.5 * x[1] + x[2]),
                "renewable_energy": 0.01 * (1.5 * x[3] + x[4] + 0.5 * x[5]),
                "policy_effectiveness": 0.01 * (x[6] + x[7] + 1.2 * x[8]),
                "ai_ethics": 0.01 * (1.5 * x[9] + x[10] + x[11]),
                "climate_health": 0.01 * (x[12] + 1.3 * x[13] + x[14])
            }
            
            # Start from current values
            projected_values = {
                name: factor.current_value + factor_deltas.get(name, 0)
                for name, factor in self.metrics.factors.items()
            }
            
            # Apply bounds
            projected_values = {
                name: max(0, min(1, value))
                for name, value in projected_values.items()
            }
            
            # Calculate projected sustainability
            projected_score = sum(
                projected_values[name] * self.metrics.factors[name].weight
                for name in projected_values.keys()
            )
            
            # We want to maximize, so return negative
            return -projected_score
        
        # Run optimization
        result = optimize.minimize(objective, x0=[5] * len(param_names), 
                                   bounds=bounds, method='SLSQP')
        
        # Parse results into more readable format
        optimized_params = {}
        for i, param in enumerate(param_names):
            optimized_params[param] = result.x[i]
        
        # Group by action type
        optimized_strategy = {
            "resource_allocation": {
                "efficiency": optimized_params["efficiency"],
                "recycling": optimized_params["recycling"],
                "conservation": optimized_params["conservation"]
            },
            "energy_transition": {
                "renewable_investment": optimized_params["renewable_investment"],
                "efficiency_measures": optimized_params["efficiency_measures"],
                "grid_modernization": optimized_params["grid_modernization"]
            },
            "policy_adaptation": {
                "regulation_quality": optimized_params["regulation_quality"],
                "incentive_programs": optimized_params["incentive_programs"],
                "international_cooperation": optimized_params["international_cooperation"]
            },
            "ai_integration": {
                "ethical_standards": optimized_params["ethical_standards"],
                "automation_balance": optimized_params["automation_balance"],
                "transparency": optimized_params["transparency"]
            },
            "climate_action": {
                "emissions_reduction": optimized_params["emissions_reduction"],
                "ecosystem_protection": optimized_params["ecosystem_protection"],
                "adaptation_measures": optimized_params["adaptation_measures"]
            },
            "projected_sustainability": -result.fun  # Convert back from negative
        }
        
        return optimized_strategy


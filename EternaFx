@dataclass
class PlayerAction:
    """Represents a single player decision in the game"""
    player_id: str
    timestamp: dt.datetime
    action_type: str  # e.g., "resource_allocation", "energy_transition"
    action_params: Dict
    faction: str
    region: str

@dataclass
class RealWorldFactor:
    """Maps a game action to real-world sustainability metrics"""
    name: str
    baseline: float
    current_value: float
    optimal_value: float
    weight: float
    uncertainty: float
    
class SustainabilityMetrics:
    """Track and calculate sustainability metrics across multiple dimensions"""
    
    def __init__(self):
        # Initialize core sustainability factors
        self.factors = {
            "resource_efficiency": RealWorldFactor("Resource Efficiency", 0.3, 0.3, 1.0, 0.2, 0.05),
            "renewable_energy": RealWorldFactor("Renewable Energy", 0.2, 0.2, 1.0, 0.25, 0.03),
            "policy_effectiveness": RealWorldFactor("Policy Effectiveness", 0.4, 0.4, 1.0, 0.15, 0.08),
            "ai_ethics": RealWorldFactor("AI Ethics & Integration", 0.5, 0.5, 1.0, 0.15, 0.1),
            "climate_health": RealWorldFactor("Climate Health", 0.3, 0.3, 1.0, 0.25, 0.07)
        }
        self.history = {name: [] for name in self.factors.keys()}
        self.sustainability_index_history = []
        
    def update_factor(self, factor_name: str, delta: float):
        """Update a specific sustainability factor based on player actions"""
        if factor_name in self.factors:
            factor = self.factors[factor_name]
            # Apply bounded update with diminishing returns
            new_value = factor.current_value + delta
            # Ensure value remains between 0 and 1 with logarithmic growth toward optimal
            factor.current_value = max(0, min(1, new_value))
            self.history[factor_name].append(factor.current_value)
            logger.debug(f"Updated {factor_name}: {factor.current_value:.4f}")
        else:
            logger.warning(f"Unknown factor: {factor_name}")
    
    def calculate_sustainability_index(self) -> Tuple[float, float]:
        """Calculate overall sustainability index and its uncertainty"""
        weighted_sum = sum(
            factor.current_value * factor.weight 
            for factor in self.factors.values()
        )
        # Calculate uncertainty as weighted average of individual uncertainties
        uncertainty = sum(
            factor.uncertainty * factor.weight
            for factor in self.factors.values()
        )
        self.sustainability_index_history.append(weighted_sum)
        return weighted_sum, uncertainty
    
    def get_improvement_areas(self) -> List[str]:
        """Identify factors that need the most improvement"""
        gaps = [(name, factor.optimal_value - factor.current_value) 
                for name, factor in self.factors.items()]
        # Sort by gap size (descending)
        sorted_gaps = sorted(gaps, key=lambda x: x[1], reverse=True)
        return [name for name, _ in sorted_gaps]

# ================================================
# Decision Engine - Evaluates Player Choices
# ================================================

class EternaFXDecisionEngine:
    """
    Processes player decisions, evaluates their impact,
    and provides feedback for optimization.
    """
    
    def __init__(self, metrics: SustainabilityMetrics):
        self.metrics = metrics
        self.player_actions_db = []
        self.decision_models = {
            "resource_allocation": self._evaluate_resource_allocation,
            "energy_transition": self._evaluate_energy_transition,
            "policy_adaptation": self._evaluate_policy_adaptation,
            "ai_integration": self._evaluate_ai_integration,
            "climate_action": self._evaluate_climate_action
        }
    
    def log_player_action(self, action: PlayerAction):
        """Record a player action and process its effects"""
        self.player_actions_db.append(action)
        
        # Process action based on its type
        if action.action_type in self.decision_models:
            evaluation_fn = self.decision_models[action.action_type]
            evaluation_fn(action)
        else:
            logger.warning(f"Unknown action type: {action.action_type}")
    
    def _evaluate_resource_allocation(self, action: PlayerAction):
        """Evaluate resource management decisions"""
        efficiency = action.action_params.get("efficiency", 0)
        recycling = action.action_params.get("recycling", 0)
        conservation = action.action_params.get("conservation", 0)
        
        # Calculate impact on resource efficiency
        delta = 0.01 * (efficiency + 1.5 * recycling + conservation)
        self.metrics.update_factor("resource_efficiency", delta)
        
        # Secondary effects
        self.metrics.update_factor("climate_health", 0.005 * conservation)
    
    def _evaluate_energy_transition(self, action: PlayerAction):
        """Evaluate energy transition decisions"""
        renewable_investment = action.action_params.get("renewable_investment", 0)
        efficiency_measures = action.action_params.get("efficiency_measures", 0)
        grid_modernization = action.action_params.get("grid_modernization", 0)
        
        # Calculate impact on renewable energy
        delta = 0.01 * (1.5 * renewable_investment + efficiency_measures + 0.5 * grid_modernization)
        self.metrics.update_factor("renewable_energy", delta)
        
        # Secondary effects
        self.metrics.update_factor("climate_health", 0.007 * renewable_investment)
    
    def _evaluate_policy_adaptation(self, action: PlayerAction):
        """Evaluate policy and governance decisions"""
        regulation_quality = action.action_params.get("regulation_quality", 0)
        incentive_programs = action.action_params.get("incentive_programs", 0)
        international_cooperation = action.action_params.get("international_cooperation", 0)
        
        # Calculate impact on policy effectiveness
        delta = 0.01 * (regulation_quality + incentive_programs + 1.2 * international_cooperation)
        self.metrics.update_factor("policy_effectiveness", delta)
        
        # Secondary effects on other factors
        self.metrics.update_factor("renewable_energy", 0.003 * incentive_programs)
    
    def _evaluate_ai_integration(self, action: PlayerAction):
        """Evaluate AI-human interaction decisions"""
        ethical_standards = action.action_params.get("ethical_standards", 0)
        automation_balance = action.action_params.get("automation_balance", 0)
        transparency = action.action_params.get("transparency", 0)
        
        # Calculate impact on AI ethics and integration
        delta = 0.01 * (1.5 * ethical_standards + automation_balance + transparency)
        self.metrics.update_factor("ai_ethics", delta)
        
        # Secondary effects
        self.metrics.update_factor("resource_efficiency", 0.004 * automation_balance)
    
    def _evaluate_climate_action(self, action: PlayerAction):
        """Evaluate climate impact decisions"""
        emissions_reduction = action.action_params.get("emissions_reduction", 0)
        ecosystem_protection = action.action_params.get("ecosystem_protection", 0)
        adaptation_measures = action.action_params.get("adaptation_measures", 0)
        
        # Calculate impact on climate health
        delta = 0.01 * (emissions_reduction + 1.3 * ecosystem_protection + adaptation_measures)
        self.metrics.update_factor("climate_health", delta)
    
    def calculate_decision_score(self, action: PlayerAction) -> float:
        """Calculate a score for a specific decision"""
        # Extract parameters
        params = action.action_params
        # Define weights for different parameters based on action type
        weights = self._get_weights_for_action(action.action_type)
        
        # Calculate weighted sum of parameters
        score = sum(
            weights.get(param, 0) * value
            for param, value in params.items()
        )
        return score
    
    def _get_weights_for_action(self, action_type: str) -> Dict[str, float]:
        """Get the appropriate weights for parameters of a specific action type"""
        weights = {
            "resource_allocation": {
                "efficiency": 0.4, 
                "recycling": 0.4, 
                "conservation": 0.2
            },
            "energy_transition": {
                "renewable_investment": 0.5, 
                "efficiency_measures": 0.3, 
                "grid_modernization": 0.2
            },
            "policy_adaptation": {
                "regulation_quality": 0.3, 
                "incentive_programs": 0.4, 
                "international_cooperation": 0.3
            }, 
            "ai_integration": {
                "ethical_standards": 0.4, 
                "automation_balance": 0.3, 
                "transparency": 0.3
            },
            "climate_action": {
                "emissions_reduction": 0.4, 
                "ecosystem_protection": 0.4, 
                "adaptation_measures": 0.2
            }
        }
        return weights.get(action_type, {})
    
    def get_recommendation(self) -> Dict:
        """Generate recommendations based on current metrics"""
        improvement_areas = self.metrics.get_improvement_areas()
        top_area = improvement_areas[0] if improvement_areas else None
        
        recommendations = {
            "resource_efficiency": {
                "action": "resource_allocation",
                "focus": "recycling",
                "rationale": "Investing in circular economy approaches maximizes resource efficiency."
            },
            "renewable_energy": {
                "action": "energy_transition",
                "focus": "renewable_investment",
                "rationale": "Accelerating renewable deployment has the highest long-term impact."
            },
            "policy_effectiveness": {
                "action": "policy_adaptation",
                "focus": "incentive_programs",
                "rationale": "Market-based incentives have proven most effective for sustainable transitions."
            },
            "ai_ethics": {
                "action": "ai_integration",
                "focus": "ethical_standards",
                "rationale": "Establishing robust ethical frameworks prevents unintended consequences."
            },
            "climate_health": {
                "action": "climate_action",
                "focus": "ecosystem_protection",
                "rationale": "Ecosystem protection provides multiple co-benefits beyond direct climate impacts."
            }
        }
        
        return recommendations.get(top_area, {})


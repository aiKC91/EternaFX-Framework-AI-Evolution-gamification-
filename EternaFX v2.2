# --------------------------
# Navier-Stokes Simulation with Adaptive Turbulence Control
# --------------------------
# Grid settings for simulation
nx, ny = 64, 64
Lx, Ly = 1.0, 1.0
dx = Lx / (nx - 1)
dy = Ly / (ny - 1)
dt = 0.001
num_steps = 300
rho = 1.0
nu = 0.01

def initial_conditions(nx, ny):
    u = np.zeros((ny, nx))
    v = np.zeros((ny, nx))
    p = np.zeros((ny, nx))
    cx, cy = nx // 2, ny // 2
    u[cy-2:cy+2, cx-2:cx+2] = 1.0
    return u, v, p

def laplacian(field):
    fxx = (np.roll(field, -1, axis=1) - 2*field + np.roll(field, 1, axis=1)) / dx**2
    fyy = (np.roll(field, -1, axis=0) - 2*field + np.roll(field, 1, axis=0)) / dy**2
    return fxx + fyy

def divergence(u, v):
    dudx = (np.roll(u, -1, axis=1) - np.roll(u, 1, axis=1)) / (2*dx)
    dvdy = (np.roll(v, -1, axis=0) - np.roll(v, 1, axis=0)) / (2*dy)
    return dudx + dvdy

def apply_boundary_conditions(u, v, p):
    u[0, :], u[-1, :], u[:, 0], u[:, -1] = 0, 0, 0, 0
    v[0, :], v[-1, :], v[:, 0], v[:, -1] = 0, 0, 0, 0
    p[0, :], p[-1, :], p[:, 0], p[:, -1] = 0, 0, 0, 0
    return u, v, p

def adaptive_dissipation(u):
    grad_y, grad_x = np.gradient(u)
    grad_mag = np.sqrt(grad_x**2 + grad_y**2)
    max_grad = np.max(grad_mag)
    return 0.01 * np.exp(-5.0 * max_grad)

def energy_recovery(epsilon):
    return 0.005 * (1 - epsilon / 0.01)**2

def simulation_step(u, v, p):
    epsilon = adaptive_dissipation(u)
    alpha = energy_recovery(epsilon)
    u_x = (np.roll(u, -1, axis=1) - np.roll(u, 1, axis=1)) / (2*dx)
    u_y = (np.roll(u, -1, axis=0) - np.roll(u, 1, axis=0)) / (2*dy)
    v_x = (np.roll(v, -1, axis=1) - np.roll(v, 1, axis=1)) / (2*dx)
    v_y = (np.roll(v, -1, axis=0) - np.roll(v, 1, axis=0)) / (2*dy)
    u_star = u + dt * (- (u*u_x + v*u_y) + epsilon*laplacian(u) + alpha)
    v_star = v + dt * (- (u*v_x + v*v_y) + epsilon*laplacian(v) + alpha)
    div_u_star = divergence(u_star, v_star)
    p_new = p.copy()
    for _ in range(50):
        p_new = 0.25 * (np.roll(p_new, 1, axis=1) + np.roll(p_new, -1, axis=1) +
                        np.roll(p_new, 1, axis=0) + np.roll(p_new, -1, axis=0) -
                        (rho * dx * dy / dt) * div_u_star)
        p_new[0, :], p_new[-1, :], p_new[:, 0], p_new[:, -1] = 0, 0, 0, 0
    p_x = (np.roll(p_new, -1, axis=1) - np.roll(p_new, 1, axis=1)) / (2*dx)
    p_y = (np.roll(p_new, -1, axis=0) - np.roll(p_new, 1, axis=0)) / (2*dy)
    u_new = u_star - (dt / rho) * p_x
    v_new = v_star - (dt / rho) * p_y
    u_new, v_new, p_new = apply_boundary_conditions(u_new, v_new, p_new)
    return u_new, v_new, p_new, epsilon, alpha

def run_navier_stokes_simulation():
    u, v, p = initial_conditions(nx, ny)
    u, v, p = apply_boundary_conditions(u, v, p)
    for step in range(num_steps):
        u, v, p, epsilon, alpha = simulation_step(u, v, p)
        if step % 50 == 0:
            print(f"Step {step}: epsilon = {epsilon:.6f}, alpha = {alpha:.6f}")
    speed = np.sqrt(u**2 + v**2)
    plt.figure(figsize=(7, 6))
    plt.imshow(speed, cmap='jet', origin='lower', extent=[0, Lx, 0, Ly])
    plt.colorbar(label='Velocity Magnitude')
    plt.title('Final Velocity Field')
    plt.xlabel('x')
    plt.ylabel('y')
    plt.show()


from qiskit import QuantumCircuit, Aer, transpile

# --------------------------
# Global Constants and Settings
# --------------------------
PHI = (1 + math.sqrt(5)) / 2            # Golden Ratio
P_NP_RATIO = {"P": 1, "NP": 2}          # Simplified P vs NP estimate

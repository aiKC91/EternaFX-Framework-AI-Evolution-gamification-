class DARTOptimizer:
    def __init__(self, initial_assets, transformation_factor=0.1):
        self.assets = np.array(initial_assets)
        self.transformation_factor = transformation_factor

    def rebalance(self):
        # Apply random adjustments and clip results
        self.assets *= (1 + np.random.randn(len(self.assets)) * self.transformation_factor)
        return np.clip(self.assets, 0, 100)


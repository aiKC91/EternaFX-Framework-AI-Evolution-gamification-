# Chat Automation Module (ChatGPT-Driven Interface)
# --------------------------
class ChatAutomation:
    def __init__(self, state_engine):
        self.state_engine = state_engine
        self.chat_history = []

    def process_command(self, command):
        command = command.lower().strip()
        response = ""
        if "update" in command:
            update_val = self.state_engine.update(DT=0.1)
            response = f"State updated. Composite update value: {round(update_val, 3)}."
        elif "status" in command:
            status = self.state_engine.get_status()
            response = "Current EternaFX Status:\n" + "\n".join(f"{k}: {v}" for k, v in status.items())
        elif "visualize" in command:
            self.state_engine.visualize_state()
            response = "Visualization launched."
        elif "ns" in command:
            # Run Navier-Stokes simulation demonstration
            run_navier_stokes_simulation()
            response = "Navier-Stokes simulation executed."
        elif "reset" in command:
            self.state_engine = EternaFXState()
            response = "State engine has been reset."
        elif "help" in command:
            response = ("Available commands:\n"
                        "- update: Perform a state update.\n"
                        "- status: Show current system status.\n"
                        "- visualize: Launch visualization of system evolution.\n"
                        "- ns: Run Navier-Stokes simulation.\n"
                        "- reset: Reset the state engine.\n"
                        "- help: Show this help message.")
        else:
            response = f"Unrecognized command: '{command}'. Type 'help' for available commands."
        self.chat_history.append({"command": command, "response": response})
        return response

    def chat_loop(self):
        print("EternaFX Chat Automation (type 'help' for commands, 'exit' to quit):")
        while True:
            try:
                user_input = input("User: ")
                if user_input.lower().strip() == "exit":
                    print("Exiting EternaFX Chat Automation.")
                    break
                response = self.process_command(user_input)
                print("EternaFX:", response)
            except KeyboardInterrupt:
                print("\nExiting EternaFX Chat Automation.")
                break


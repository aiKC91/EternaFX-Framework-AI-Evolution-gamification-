def plot_velocity_field(history: List[np.ndarray], title: str = "Velocity Evolution Over Time"):
    """Plot the time evolution of velocity field as a heatmap"""
    if not history:
        logger.warning("Empty history provided to plot_velocity_field.")
        return

    velocity_matrix = np.array(history)
    plt.figure(figsize=(12, 6))
    sns.heatmap(velocity_matrix.T, cmap="viridis", cbar_kws={'label': 'Velocity'})
    plt.title(title)
    plt.xlabel("Time Step")
    plt.ylabel("Spatial Index")
    plt.tight_layout()
    plt.show()

def plot_fourier_spectrum(fourier_history: List[Tuple[np.ndarray, np.ndarray]], 
                         step_interval: int = 5, 
                         title: str = "Energy Spectrum Evolution"):
    """Plot the evolution of Fourier energy spectrum"""
    if not fourier_history:
        return
    
    plt.figure(figsize=(12, 8))
    cmap = plt.cm.viridis
    
    for i, (freqs, spectrum) in enumerate(fourier_history):
        if i % step_interval == 0 or i == len(fourier_history)-1:
            # Plot only up to Nyquist frequency
            valid = freqs > 0
            plt.loglog(freqs[valid], spectrum[valid], 
                      color=cmap(i/len(fourier_history)), 
                      alpha=0.6,
                      label=f"t={i}" if i in [0, len(fourier_history)-1] else None)
    
    plt.title(title, fontsize=16)
    plt.xlabel("Wavenumber (log scale)", fontsize=14)
    plt.ylabel("Energy Spectrum (log scale)", fontsize=14)
    plt.grid(True, which="both", ls="--", alpha=0.6)
    plt.legend()
    plt.colorbar(plt.cm.ScalarMappable(cmap=cmap), label='Time progression')
    plt.show()

def animate_velocity_gif(history: List[np.ndarray], filename: str, fps: int = 20):
    """Create and save a GIF animation of velocity evolution"""
    fig, ax = plt.subplots(figsize=(10, 6))
    ax.set_xlim(0, len(history[0]))
    ax.set_ylim(0, max(1.1, np.max(history)*1.1))
    ax.set_title("Fluid Velocity Evolution", fontsize=14)
    ax.set_xlabel("Position", fontsize=12)
    ax.set_ylabel("Velocity", fontsize=12)
    ax.grid(True, linestyle='--', alpha=0.5)
    
    line, = ax.plot([], [], 'b-', linewidth=2)
    time_text = ax.text(0.02, 0.95, '', transform=ax.transAxes, fontsize=12)
    
    def init():
        line.set_data([], [])
        time_text.set_text('Time = 0')
        return line, time_text
    
    def update(frame):
        line.set_data(np.arange(len(history[frame])), history[frame])
        time_text.set_text(f'Time = {frame}')
        return line, time_text
    
    anim = FuncAnimation(fig, update, frames=len(history), 
                         init_func=init, blit=True, interval=50)
    
    # Save as GIF
    anim.save(filename, writer=PillowWriter(fps=fps))
    plt.close()
    logger.info(f"Animation saved as {filename}")


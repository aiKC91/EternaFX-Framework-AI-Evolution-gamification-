# 1. Enhanced Modular Discretization Framework (MDF)
# =============================================================================
class ModularDiscretizationFramework:
    """Hybrid high-order discrete difference + series-based dissipation"""
    def __init__(self, delta_x: float, M: int=4, s: float=1.5, alpha: float=0.01, N_terms: int=100):
        self.delta_x = delta_x
        self.M = M
        self.s = s
        self.alpha = alpha
        self.N_terms = N_terms
        self.w = [1.0/(2**m) for m in range(1, M+1)]
        self.a_n = self._generate_series_coefficients(N_terms)
        self.convergence_history = []

    def _generate_series_coefficients(self, N: int) -> List[float]:
        """Generate coefficients with convergence properties"""
        return [1.0/(n**1.8) * (0.9 if n % 2 == 0 else 1.1) for n in range(1, N+1)]
    
    def symbolic_representation(self) -> str:
        """Generate symbolic representation of the operator"""
        terms = []
        for m in range(1, self.M+1):
            binom_terms = []
            for k in range(m+1):
                sign = "-" if k % 2 == 1 else "+"
                binom_terms.append(f"{sign} binom({m},{k})·u_{i+{m-k}}")
            terms.append(f"w_{m} * [{' '.join(binom_terms)}] / (Δx)^{m}")
        
        series_terms = " + ".join([f"a_{n}/({n+1})^{self.s}" for n in range(self.N_terms)])
        series_part = f"α * [{series_terms}] * u_i"
        
        return " + ".join(terms) + " + " + series_part

    def discrete_difference(self, u: np.ndarray, m: int) -> np.ndarray:
        N = len(u)
        Dm = np.zeros_like(u)
        for i in range(N):
            for k in range(m+1):
                idx = (i + m - k) % N
                Dm[i] += ((-1)**k) * math.comb(m, k) * u[idx]
        return Dm / (self.delta_x**m)

    def series_dissipation(self, u: np.ndarray) -> np.ndarray:
        coef = sum(self.a_n[n]/((n+1)**self.s) for n in range(self.N_terms))
        return self.alpha * coef * u

    def apply_operator(self, u: np.ndarray) -> np.ndarray:
        D_u = np.zeros_like(u)
        for m in range(1, self.M+1):
            D_u += self.w[m-1] * self.discrete_difference(u, m)
        D_u += self.series_dissipation(u)
        return D_u

    def update_weights(self, grad: List[float], lr: float=0.01):
        for i in range(self.M):
            self.w[i] = max(1e-3, self.w[i] - lr*grad[i])
        self.convergence_history.append(self.w.copy())

    def visualize_convergence(self):
        if not self.convergence_history:
            return
        
        plt.figure(figsize=(10, 6))
        history = np.array(self.convergence_history)
        for i in range(history.shape[1]):
            plt.plot(history[:, i], label=f'Weight {i+1}')
        plt.title('MDF Weight Convergence History')
        plt.xlabel('Optimization Step')
        plt.ylabel('Weight Value')
        plt.legend()
        plt.grid(True)
        plt.show()


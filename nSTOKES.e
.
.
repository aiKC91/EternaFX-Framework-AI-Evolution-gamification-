# 5. Advanced Mathematical Metrics
# =============================================================================
class AdvancedMetrics:
    """Compute advanced mathematical metrics for solution quality"""
    
    @staticmethod
    def compute_entropy(u: np.ndarray) -> float:
        """Compute entropy of the solution field"""
        # Normalize to probability distribution
        u_pos = np.abs(u) + 1e-12
        p = u_pos / np.sum(u_pos)
        entropy = -np.sum(p * np.log(p + 1e-12))
        return entropy
    
    @staticmethod
    def compute_fractal_dimension(u: np.ndarray) -> float:
        """Estimate fractal dimension using box-counting method"""
        if len(u) < 8:
            return 1.0
        
        # Simple 1D box-counting
        scales = [2**i for i in range(1, int(np.log2(len(u)//4)) + 1)]
        counts = []
        
        for scale in scales:
            boxes = len(u) // scale
            count = 0
            for i in range(boxes):
                box_slice = u[i*scale:(i+1)*scale]
                if np.var(box_slice) > 1e-6:  # Non-trivial variation
                    count += 1
            counts.append(count)
        
        if len(counts) > 1:
            # Linear fit of log(count) vs log(1/scale)
            log_scales = np.log([1/s for s in scales])
            log_counts = np.log([max(c, 1) for c in counts])
            fractal_dim = np.polyfit(log_scales, log_counts, 1)[0]
            return max(1.0, min(2.0, fractal_dim))
        
        return 1.0
    
    @staticmethod
    def compute_holder_exponent(u: np.ndarray) -> float:
        """Estimate Hölder exponent for regularity analysis"""
        if len(u) < 4:
            return 1.0
        
        # Compute differences at multiple scales
        scales = [1, 2, 4]
        holder_estimates = []
        
        for h in scales:
            if len(u) > 2*h:
                diff = np.abs(u[h:] - u[:-h])
                avg_diff = np.mean(diff)
                if avg_diff > 1e-12:
                    # Hölder estimate: |f(x+h) - f(x)| ≤ C * h^α
                    alpha_est = np.log(avg_diff) / np.log(h)
                    holder_estimates.append(min(1.0, max(0.1, alpha_est)))
        
        return np.mean(holder_estimates) if holder_estimates else 1.0


# 8. Benchmarking and Comparison
# =============================================================================
def benchmark_methods(problem: MillenniumProblem, configs: List[Dict]) -> Dict[str, List[float]]:
    """Benchmark different simulation configurations"""
    results = {
        'config': [],
        'stability_score': [],
        'accuracy_score': [],
        'computational_cost': []
    }
    
    for i, config in enumerate(configs):
        logger.info(f"Running benchmark {i+1}/{len(configs)}")
        
        import time
        start_time = time.time()
        
        # Run simulation with this configuration
        sim_results = problem.run_sim(**config)
        
        computation_time = time.time() - start_time
        
        # Extract metrics
        stability_score = sim_results.get('stability_score', 0.0)
        accuracy_score = 1.0 / (1.0 + sim_results.get('smoothness_metric', 1.0))
        
        results['config'].append(f"Config_{i}")
        results['stability_score'].append(stability_score)
        results['accuracy_score'].append(accuracy_score)
        results['computational_cost'].append(computation_time)
    
    return results

def plot_benchmark_results(results: Dict[str, List[float]]):
    """Visualize benchmark results"""
    configs = results['config']
    stability = results['stability_score']
    accuracy = results['accuracy_score']
    cost = results['computational_cost']
    
    fig, ax1 = plt.subplots(figsize=(12, 6))
    
    # Stability and Accuracy
    index = np.arange(len(configs))
    bar_width = 0.35
    
    ax1.bar(index, stability, bar_width, label='Stability Score', color='skyblue')
    ax1.bar(index + bar_width, accuracy, bar_width, label='Accuracy Score', color='salmon')
    ax1.set_xlabel('Configuration')
    ax1.set_ylabel('Scores')
    ax1.set_title('Simulation Benchmark Results')
    ax1.set_xticks(index + bar_width / 2)
    ax1.set_xticklabels(configs)
    ax1.legend(loc='upper left')
    
    # Computational Cost
    ax2 = ax1.twinx()
    ax2.plot(index + bar_width / 2, cost, 'g-o', linewidth=2, label='Computation Time (s)')
    ax2.set_ylabel('Computation Time (s)', color='g')
    ax2.tick_params(axis='y', labelcolor='g')
    ax2.legend(loc='upper right')
    
    plt.tight_layout()
    plt.show()


# 4. Machine Learning Stability Prediction
# =============================================================================
class MLStabilityPredictor:
    """Machine learning model to predict simulation stability"""
    
    def __init__(self):
        self.training_data = []
        self.model_trained = False
        self.feature_names = [
            'viscosity', 'max_velocity', 'energy_dissipation', 
            'smoothness_metric', 'gradient_norm', 'total_variation'
        ]
    
    def extract_features(self, metrics: Dict[str, float]) -> np.ndarray:
        """Extract feature vector from simulation metrics"""
        features = []
        for name in self.feature_names:
            features.append(metrics.get(name, 0.0))
        return np.array(features)
    
    def add_training_sample(self, metrics: Dict[str, float], is_stable: bool):
        """Add a training sample to the dataset"""
        features = self.extract_features(metrics)
        self.training_data.append((features, int(is_stable)))
    
    def train_simple_model(self):
        """Train a simple threshold-based stability predictor"""
        if len(self.training_data) < 5:
            print("Insufficient training data")
            return
        
        # Extract features and labels
        X = np.array([sample[0] for sample in self.training_data])
        y = np.array([sample[1] for sample in self.training_data])
        
        # Simple linear threshold model
        self.stability_thresholds = {}
        for i, feature_name in enumerate(self.feature_names):
            stable_values = X[y == 1, i]
            unstable_values = X[y == 0, i]
            
            if len(stable_values) > 0 and len(unstable_values) > 0:
                # Use median values as threshold
                threshold = (np.median(stable_values) + np.median(unstable_values)) / 2
                self.stability_thresholds[feature_name] = threshold
        
        self.model_trained = True
        print(f"Trained stability predictor with {len(self.training_data)} samples")
    
    def predict_stability(self, metrics: Dict[str, float]) -> Tuple[bool, float]:
        """Predict stability and return confidence score"""
        if not self.model_trained:
            return True, 0.5  # Default to stable with low confidence
        
        features = self.extract_features(metrics)
        stability_votes = 0
        total_votes = 0
        
        for i, feature_name in enumerate(self.feature_names):
            if feature_name in self.stability_thresholds:
                threshold = self.stability_thresholds[feature_name]
                if features[i] <= threshold:
                    stability_votes += 1
                total_votes += 1
        
        if total_votes == 0:
            return True, 0.5
        
        confidence = stability_votes / total_votes
        is_stable = confidence > 0.5
        
        return is_stable, confidence


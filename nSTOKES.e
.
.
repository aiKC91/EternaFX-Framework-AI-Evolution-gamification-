# 3. Adaptive Parameter Optimization
# =============================================================================
class AdaptiveParameterOptimizer:
    """Optimize MDF parameters based on stability and accuracy metrics"""
    
    def __init__(self, target_metrics: Dict[str, float]):
        self.target_metrics = target_metrics
        self.optimization_history = []
    
    def objective_function(self, params: np.ndarray, mdf: ModularDiscretizationFramework, 
                          test_function: Callable) -> float:
        """Objective function for parameter optimization"""
        try:
            # Update MDF parameters
            mdf.alpha = max(1e-6, params[0])
            mdf.s = max(1.0, params[1])
            if len(params) > 2:
                mdf.w = [max(1e-3, w) for w in params[2:2+len(mdf.w)]]
            
            # Run test simulation
            test_result = test_function(mdf)
            
            # Compute objective (minimize deviation from targets)
            objective = 0.0
            for key, target in self.target_metrics.items():
                if key in test_result:
                    objective += (test_result[key] - target)**2
            
            return objective
        except:
            return float('inf')
    
    def optimize_mdf_parameters(self, mdf: ModularDiscretizationFramework, 
                               test_function: Callable, 
                               max_iterations: int = 50) -> Dict[str, float]:
        """Optimize MDF parameters using scipy.optimize"""
        
        # Initial parameter vector
        initial_params = [mdf.alpha, mdf.s] + mdf.w
        
        # Bounds for parameters
        bounds = [(1e-6, 1.0), (1.0, 3.0)] + [(1e-3, 2.0) for _ in mdf.w]
        
        # Optimization
        try:
            result = minimize(
                self.objective_function,
                initial_params,
                args=(mdf, test_function),
                bounds=bounds,
                method='L-BFGS-B',
                options={'maxiter': max_iterations}
            )
            
            # Update MDF with optimized parameters
            if result.success:
                mdf.alpha = result.x[0]
                mdf.s = result.x[1]
                mdf.w = list(result.x[2:2+len(mdf.w)])
            
            self.optimization_history.append({
                'success': result.success,
                'final_objective': result.fun,
                'parameters': result.x.tolist(),
                'iterations': result.nit
            })
            
            return {
                'optimization_success': result.success,
                'final_objective': result.fun,
                'optimized_alpha': result.x[0],
                'optimized_s': result.x[1],
                'optimized_weights': result.x[2:2+len(mdf.w)].tolist()
            }
        except Exception as e:
            print(f"Optimization failed: {e}")
            return {'optimization_success': False}


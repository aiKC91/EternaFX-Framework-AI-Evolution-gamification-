    plt.subplot(4, 1, 1)
    plt.plot(timestamps, energy, 'o-')
    plt.title('Energy Dissipation Evolution', fontsize=16)
    plt.ylabel('Energy', fontsize=14)
    plt.grid(True, alpha=0.3)
    
    # Solution smoothness
    plt.subplot(4, 1, 2)
    plt.plot(timestamps, smoothness, 'o-', color='green')
    plt.title('Solution Smoothness Evolution', fontsize=16)
    plt.ylabel('Smoothness Metric', fontsize=14)
    plt.grid(True, alpha=0.3)
    
    # Lyapunov exponent
    plt.subplot(4, 1, 3)
    plt.plot(timestamps, lyapunov, 'o-', color='purple')
    plt.title('Lyapunov Exponent Evolution', fontsize=16)
    plt.ylabel('Lyapunov Exponent', fontsize=14)
    plt.grid(True, alpha=0.3)
    
    # Stability status
    plt.subplot(4, 1, 4)
    plt.step(timestamps, stability, where='post', color='red')
    plt.title('Stability Status', fontsize=16)
    plt.ylabel('Stable (1) / Unstable (0)', fontsize=14)
    plt.yticks([0, 1], ['Unstable', 'Stable'])
    plt.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()


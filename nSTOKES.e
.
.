# =============================================================================
class StabilityAnalyzer:
    """Advanced stability analysis using Lyapunov exponents and spectral radius"""
    
    def __init__(self):
        self.lyapunov_history = []
        self.spectral_radius_history = []
    
    def compute_lyapunov_exponent(self, trajectory: np.ndarray, dt: float = 0.001) -> float:
        """Estimate largest Lyapunov exponent from trajectory"""
        if len(trajectory) < 10:
            return 0.0
        
        # Compute local divergence rates
        divergence_rates = []
        for i in range(1, len(trajectory)-1):
            # Simple finite difference approximation
            local_rate = np.abs(trajectory[i+1] - trajectory[i]) / dt
            if local_rate > 1e-12:
                divergence_rates.append(np.log(local_rate))
        
        return np.mean(divergence_rates) if divergence_rates else 0.0
    
    def compute_spectral_radius(self, jacobian: np.ndarray) -> float:
        """Compute spectral radius of Jacobian matrix"""
        try:
            eigenvals = np.linalg.eigvals(jacobian)
            return np.max(np.abs(eigenvals))
        except:
            return float('inf')
    
    def analyze_trajectory_stability(self, trajectory: List[np.ndarray]) -> Dict[str, float]:
        """Comprehensive stability analysis of a trajectory"""
        if not trajectory:
            return {}
        
        # Convert to array format
        traj_array = np.array(trajectory)
        
        # Lyapunov exponent
        lyap_exp = self.compute_lyapunov_exponent(traj_array)
        self.lyapunov_history.append(lyap_exp)
        
        # Trajectory statistics
        energy_trend = [np.sum(state**2) for state in trajectory]
        energy_growth_rate = np.polyfit(range(len(energy_trend)), np.log(np.array(energy_trend) + 1e-12), 1)[0]
        
        # Frequency analysis
        if len(trajectory) > 10:
            # Power spectral density
            freqs, psd = welch(energy_trend, nperseg=min(len(energy_trend)//4, 256))
            dominant_freq = freqs[np.argmax(psd)] if len(psd) > 0 else 0.0
        else:
            dominant_freq = 0.0
        
        return {
            'lyapunov_exponent': lyap_exp,
            'energy_growth_rate': energy_growth_rate,
            'dominant_frequency': dominant_freq,
            'max_amplitude': np.max([np.max(np.abs(state)) for state in trajectory]),
            'stability_score': 1.0 / (1.0 + abs(lyap_exp)) if lyap_exp != float('inf') else 0.0
        }


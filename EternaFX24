# 1. HPC PDE MODULE (Navier-Stokes)
# ---------------------------

class NavierStokesSolver:
    def __init__(self, nx=64, ny=64, Lx=1.0, Ly=1.0, dt=0.001, num_steps=100, viscosity=1e-3, density=1.0):
        self.nx, self.ny = nx, ny
        self.Lx, self.Ly = Lx, Ly
        self.dx, self.dy = Lx / (nx - 1), Ly / (ny - 1)
        self.dt, self.num_steps = dt, num_steps
        self.viscosity, self.density = viscosity, density
        self.u, self.v, self.p = self._initial_conditions()

    def _initial_conditions(self):
        u = np.zeros((self.ny, self.nx))
        v = np.zeros((self.ny, self.nx))
        p = np.zeros((self.ny, self.nx))
        cx, cy = self.nx // 2, self.ny // 2
        u[cy - 2:cy + 2, cx - 2:cx + 2] = 1.0
        return u, v, p

    def _laplacian(self, field):
        fxx = (np.roll(field, -1, axis=1) - 2 * field + np.roll(field, 1, axis=1)) / self.dx**2
        fyy = (np.roll(field, -1, axis=0) - 2 * field + np.roll(field, 1, axis=0)) / self.dy**2
        return fxx + fyy

    def _divergence(self, u, v):
        dudx = (np.roll(u, -1, axis=1) - np.roll(u, 1, axis=1)) / (2 * self.dx)
        dvdy = (np.roll(v, -1, axis=0) - np.roll(v, 1, axis=0)) / (2 * self.dy)
        return dudx + dvdy

    def _apply_boundary_conditions(self, u, v, p):
        u[0, :], u[-1, :], u[:, 0], u[:, -1] = 0, 0, 0, 0
        v[0, :], v[-1, :], v[:, 0], v[:, -1] = 0, 0, 0, 0
        p[0, :], p[-1, :], p[:, 0], p[:, -1] = 0, 0, 0, 0
        return u, v, p

    def _simulation_step(self):
        u_x = (np.roll(self.u, -1, axis=1) - np.roll(self.u, 1, axis=1)) / (2 * self.dx)
        u_y = (np.roll(self.u, -1, axis=0) - np.roll(self.u, 1, axis=0)) / (2 * self.dy)
        v_x = (np.roll(self.v, -1, axis=1) - np.roll(self.v, 1, axis=1)) / (2 * self.dx)
        v_y = (np.roll(self.v, -1, axis=0) - np.roll(self.v, 1, axis=0)) / (2 * self.dy)
        u_star = self.u + self.dt * (- (self.u * u_x + self.v * u_y) + self.viscosity * self._laplacian(self.u))
        v_star = self.v + self.dt * (- (self.u * v_x + self.v * v_y) + self.viscosity * self._laplacian(self.v))
        div_u_star = self._divergence(u_star, v_star)
        p_new = self.p.copy()
        for _ in range(50):
            p_new = 0.25 * (np.roll(p_new, 1, axis=1) + np.roll(p_new, -1, axis=1) +
                            np.roll(p_new, 1, axis=0) + np.roll(p_new, -1, axis=0) -
                            (self.density * self.dx * self.dy / self.dt) * div_u_star)
            p_new = self._apply_boundary_conditions(p_new, 0, 0)[2]
        p_x = (np.roll(p_new, -1, axis=1) - np.roll(p_new, 1, axis=1)) / (2 * self.dx)
        p_y = (np.roll(p_new, -1, axis=0) - np.roll(p_new, 1, axis=0)) / (2 * self.dy)
        u_new = u_star - (self.dt / self.density) * p_x
        v_new = v_star - (self.dt / self.density) * p_y
        self.u, self.v, self.p = self._apply_boundary_conditions(u_new, v_new, p_new)

    def run_simulation(self):
        for _ in range(self.num_steps):
            self._simulation_step()
        speed = np.sqrt(self.u**2 + self.v**2)
        return speed

    def visualize(self, speed):
        plt.imshow(speed, cmap='jet', origin='lower', extent=[0, self.Lx, 0, self.Ly])
        plt.colorbar(label='Velocity Magnitude')
        plt.title('Navier-Stokes Simulation')
        plt.show()


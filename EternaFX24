# 2. Number Theory: Riemann Zeta
# ---------------------------

class RiemannZetaModule:
    def approximate_zeta(self, s, terms=100):
        result = 0.0
        for n in range(1, terms + 1):
            result += 1 / (n**s)
        return result

    def find_zeros(self, imaginary_part, search_range=(-10, 10)):
        def zeta_real(x):
            return np.real(self.approximate_zeta(0.5 + (imaginary_part + x) * 1j))

        root_result = root(zeta_real, 0)
        if root_result.success:
            return 0.5 + (imaginary_part + root_result.x[0]) * 1j
        else:
            return None


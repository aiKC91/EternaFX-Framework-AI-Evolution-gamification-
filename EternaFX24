class TestEternaFX(unittest.TestCase):
    def test_navier_stokes(self):
        solver = NavierStokesSolver(nx=10, ny=10, num_steps=5)
        speed = solver.run_simulation()
        self.assertEqual(speed.shape, (10, 10))

    def test_riemann_zeta(self):
        zeta_module = RiemannZetaModule()
        result = zeta_module.approximate_zeta(2)
        self.assertAlmostEqual(result, np.pi**2 / 6, places=5)


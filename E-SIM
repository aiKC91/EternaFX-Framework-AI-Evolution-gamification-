import React, { useState, useEffect, useRef } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { Play, Pause, RotateCcw, Activity } from 'lucide-react';

const EternaFXReasoner = () => {
  const [isRunning, setIsRunning] = useState(false);
  const [timeStep, setTimeStep] = useState(0);
  const [diagnostics, setDiagnostics] = useState([]);
  const [currentState, setCurrentState] = useState({
    H: 0, P: 0, R: 0, Z: 0, Q: 0, G: 0,
    T1: 0, T2: 0, T3: 0, T4: 0, T5: 0, T6: 0,
    D1: 0, D2: 0, D3: 0, D4: 0, D5: 0, D6: 0,
    E: 0
  });
  
  const intervalRef = useRef(null);
  const learningRate = 0.01;
  
  // Prize Problem definitions
  const problems = [
    { name: "Riemann Hypothesis", symbol: "T₁", diagnostic: "Zero Distribution Error δ₁", color: "#8884d8" },
    { name: "P vs NP", symbol: "T₂", diagnostic: "Complexity Gap Δ₂", color: "#82ca9d" },
    { name: "Navier-Stokes", symbol: "T₃", diagnostic: "Enstrophy Margin ε₃", color: "#ffc658" },
    { name: "Birch-Swinnerton-Dyer", symbol: "T₄", diagnostic: "Rank Detection ρ₄", color: "#ff7c7c" },
    { name: "Yang-Mills", symbol: "T₅", diagnostic: "Mass Gap Λ₅", color: "#8dd1e1" },
    { name: "Hodge Conjecture", symbol: "T₆", diagnostic: "Cycle Rank Δ₆", color: "#d084d0" }
  ];

  // Mathematical simulation functions
  const computeBaseTerm = (symbol, t, noise = 0.1) => {
    const base = Math.sin(t * 0.1) * Math.cos(t * 0.05) + 
                 Math.sin(t * 0.03) * 0.5 + 
                 (Math.random() - 0.5) * noise;
    return Math.max(0, base + 1);
  };

  const computePrizeTerm = (problemIndex, t, params) => {
    const frequencies = [0.07, 0.11, 0.13, 0.17, 0.19, 0.23];
    const phases = [0, Math.PI/6, Math.PI/4, Math.PI/3, Math.PI/2, 2*Math.PI/3];
    
    const freq = frequencies[problemIndex];
    const phase = phases[problemIndex];
    const damping = Math.exp(-t * 0.001);
    
    return damping * (Math.sin(freq * t + phase) + 0.5 * Math.cos(freq * t * 1.3)) * params[problemIndex];
  };

  const computeDiagnostic = (Ti, problemIndex, t) => {
    // Different diagnostic computations for each problem
    const diagnosticFunctions = [
      (T, t) => Math.abs(T * Math.sin(t * 0.02)), // Riemann: zero distribution
      (T, t) => Math.max(0, T - Math.cos(t * 0.08)), // P vs NP: complexity gap
      (T, t) => T * T + Math.sin(t * 0.06), // Navier-Stokes: enstrophy
      (T, t) => Math.abs(T - 0.5), // BSD: rank detection
      (T, t) => Math.max(0.1, T + 0.3), // Yang-Mills: mass gap
      (T, t) => T * Math.cos(t * 0.04) + 0.2 // Hodge: cycle rank
    ];
    
    return diagnosticFunctions[problemIndex](Ti, t);
  };

  const runDiagnosticStep = () => {
    const t = timeStep;
    
    // Compute base terms H, P, R, Z, Q, G
    const H = computeBaseTerm('H', t);
    const P = computeBaseTerm('P', t);
    const R = computeBaseTerm('R', t);
    const Z = computeBaseTerm('Z', t);
    const Q = computeBaseTerm('Q', t);
    const G = computeBaseTerm('G', t);
    
    // Initialize or update parameters
    let params = [1.0, 1.2, 0.8, 1.5, 0.9, 1.1];
    
    // Compute Prize Problem terms T₁ through T₆
    const T = params.map((param, i) => computePrizeTerm(i, t, params));
    
    // Compute diagnostic metrics D₁ through D₆
    const D = T.map((Ti, i) => computeDiagnostic(Ti, i, t));
    
    // Compute global energy functional
    const sumT = T.reduce((sum, Ti) => sum + Ti, 0);
    const baseSum = H + P + R + Z + Q + G;
    const E = Math.exp(-0.1) * (baseSum + sumT); // Φ[·] = exponential scaling
    
    const newState = {
      H, P, R, Z, Q, G,
      T1: T[0], T2: T[1], T3: T[2], T4: T[3], T5: T[4], T6: T[5],
      D1: D[0], D2: D[1], D3: D[2], D4: D[3], D5: D[4], D6: D[5],
      E
    };
    
    setCurrentState(newState);
    
    // Store diagnostic data
    const newDiagnostic = {
      t,
      ...newState
    };
    
    setDiagnostics(prev => {
      const updated = [...prev, newDiagnostic];
      return updated.slice(-50); // Keep last 50 points
    });
    
    setTimeStep(t + 1);
  };

  useEffect(() => {
    if (isRunning) {
      intervalRef.current = setInterval(runDiagnosticStep, 200);
    } else {
      clearInterval(intervalRef.current);
    }
    
    return () => clearInterval(intervalRef.current);
  }, [isRunning, timeStep]);

  const toggleSimulation = () => {
    setIsRunning(!isRunning);
  };

  const resetSimulation = () => {
    setIsRunning(false);
    setTimeStep(0);
    setDiagnostics([]);
    setCurrentState({
      H: 0, P: 0, R: 0, Z: 0, Q: 0, G: 0,
      T1: 0, T2: 0, T3: 0, T4: 0, T5: 0, T6: 0,
      D1: 0, D2: 0, D3: 0, D4: 0, D5: 0, D6: 0,
      E: 0
    });
  };

  return (
    <div className="w-full max-w-7xl mx-auto p-6 bg-gray-900 text-white min-h-screen">
      <div className="mb-6">
        <h1 className="text-3xl font-bold mb-2 text-blue-400">
          EternaFX Reasoner
        </h1>
        <p className="text-gray-300 mb-4">
          Continuous Diagnostics for Millennium Prize Problems
        </p>
        
        <div className="flex gap-4 mb-6">
          <button
            onClick={toggleSimulation}
            className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors ${
              isRunning ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700'
            }`}
          >
            {isRunning ? <Pause size={18} /> : <Play size={18} />}
            {isRunning ? 'Pause' : 'Start'}
          </button>
          
          <button
            onClick={resetSimulation}
            className="flex items-center gap-2 px-4 py-2 bg-gray-600 hover:bg-gray-700 rounded-lg font-medium transition-colors"
          >
            <RotateCcw size={18} />
            Reset
          </button>
          
          <div className="flex items-center gap-2 px-4 py-2 bg-gray-800 rounded-lg">
            <Activity size={18} className="text-blue-400" />
            <span>Step: {timeStep}</span>
          </div>
        </div>
      </div>

      {/* Energy Functional Display */}
      <div className="bg-gray-800 rounded-lg p-4 mb-6">
        <h2 className="text-xl font-semibold mb-3 text-blue-400">
          Global Energy Functional E(x,t) = Φ[H + P + R + Z + Q + G + ∑Tᵢ]
        </h2>
        <div className="text-3xl font-mono text-green-400 mb-2">
          E = {currentState.E.toFixed(4)}
        </div>
        <div className="grid grid-cols-3 gap-4 text-sm">
          <div>Base Terms: H={currentState.H.toFixed(3)}, P={currentState.P.toFixed(3)}</div>
          <div>R={currentState.R.toFixed(3)}, Z={currentState.Z.toFixed(3)}</div>
          <div>Q={currentState.Q.toFixed(3)}, G={currentState.G.toFixed(3)}</div>
        </div>
      </div>

      {/* Prize Problems Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        {problems.map((problem, i) => (
          <div key={i} className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-lg font-semibold mb-2" style={{color: problem.color}}>
              {problem.name}
            </h3>
            <div className="grid grid-cols-2 gap-4 text-sm">
              <div>
                <span className="text-gray-400">Term:</span>
                <div className="font-mono text-lg">
                  {problem.symbol} = {currentState[`T${i+1}`].toFixed(4)}
                </div>
              </div>
              <div>
                <span className="text-gray-400">Diagnostic:</span>
                <div className="font-mono text-lg" style={{color: problem.color}}>
                  D₍{i+1}₎ = {currentState[`D${i+1}`].toFixed(4)}
                </div>
              </div>
            </div>
            <div className="text-xs text-gray-400 mt-1">
              {problem.diagnostic}
            </div>
          </div>
        ))}
      </div>

      {/* Diagnostic Charts */}
      {diagnostics.length > 0 && (
        <div className="space-y-6">
          <div className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-xl font-semibold mb-4">Global Energy Evolution</h3>
            <ResponsiveContainer width="100%" height={200}>
              <LineChart data={diagnostics}>
                <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
                <XAxis dataKey="t" stroke="#9CA3AF" />
                <YAxis stroke="#9CA3AF" />
                <Tooltip 
                  contentStyle={{ backgroundColor: '#1F2937', border: '1px solid #374151' }}
                  labelStyle={{ color: '#F3F4F6' }}
                />
                <Line type="monotone" dataKey="E" stroke="#60A5FA" strokeWidth={2} dot={false} />
              </LineChart>
            </ResponsiveContainer>
          </div>

          <div className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-xl font-semibold mb-4">Prize Problem Terms (Tᵢ)</h3>
            <ResponsiveContainer width="100%" height={300}>
              <LineChart data={diagnostics}>
                <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
                <XAxis dataKey="t" stroke="#9CA3AF" />
                <YAxis stroke="#9CA3AF" />
                <Tooltip 
                  contentStyle={{ backgroundColor: '#1F2937', border: '1px solid #374151' }}
                  labelStyle={{ color: '#F3F4F6' }}
                />
                <Legend />
                {problems.map((problem, i) => (
                  <Line 
                    key={i}
                    type="monotone" 
                    dataKey={`T${i+1}`} 
                    stroke={problem.color} 
                    strokeWidth={1.5}
                    dot={false}
                    name={`T₍${i+1}₎ ${problem.name.split(' ')[0]}`}
                  />
                ))}
              </LineChart>
            </ResponsiveContainer>
          </div>

          <div className="bg-gray-800 rounded-lg p-4">
            <h3 className="text-xl font-semibold mb-4">Diagnostic Metrics (Dᵢ)</h3>
            <ResponsiveContainer width="100%" height={300}>
              <LineChart data={diagnostics}>
                <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
                <XAxis dataKey="t" stroke="#9CA3AF" />
                <YAxis stroke="#9CA3AF" />
                <Tooltip 
                  contentStyle={{ backgroundColor: '#1F2937', border: '1px solid #374151' }}
                  labelStyle={{ color: '#F3F4F6' }}
                />
                <Legend />
                {problems.map((problem, i) => (
                  <Line 
                    key={i}
                    type="monotone" 
                    dataKey={`D${i+1}`} 
                    stroke={problem.color} 
                    strokeWidth={1.5}
                    dot={false}
                    name={`D₍${i+1}₎ ${problem.name.split(' ')[0]}`}
                  />
                ))}
              </LineChart>
            </ResponsiveContainer>
          </div>
        </div>
      )}

      {/* Algorithm Description */}
      <div className="mt-8 bg-gray-800 rounded-lg p-4">
        <h3 className="text-xl font-semibold mb-3">Continuous Diagnostic Loop</h3>
        <pre className="text-sm text-gray-300 overflow-x-auto">
{`for each time step t:
    compute all base terms H,P,R,Z,Q,G
    for each problem i in 1..6:
        compute Tᵢ and its diagnostic metric Dᵢ
        compute gradients ∂Dᵢ/∂θᵢ for parameters θᵢ
        update θᵢ ← θᵢ - γ·∂Dᵢ/∂θᵢ
    end
    E = Φ*(H+P+R+Z+Q+G+sum(Tᵢ))
    log({t, H,P,R,Z,Q,G, {Dᵢ}, E})
end`}
        </pre>
        <div className="mt-2 text-sm text-gray-400">
          γ = {learningRate} (learning rate) | Real-time parameter optimization active
        </div>
      </div>
    </div>
  );
};

export default EternaFXReasoner;
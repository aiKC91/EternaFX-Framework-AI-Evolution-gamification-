import React, { useState, useEffect } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, BarChart, Bar } from 'recharts';
import { Calculator, TrendingUp, Zap, Activity, Atom, Compass } from 'lucide-react';

const EternaFXReasoner = () => {
  const [params, setParams] = useState({
    // H(x,t) parameters
    R_d: 0.8,
    E_s: 0.5,
    C_m: 0.2,
    
    // P(x,t) parameters
    events: [0.3, 0.5, 0.2],
    tau_p: 2.0,
    
    // R(x,t) parameters
    U_amplitude: 1.0,
    G_kernel: 0.5,
    
    // Z(x,t) parameters
    E_Z: 1.0,
    omega: 0.1,
    
    // Q(x,t) parameters
    hbar: 1.0,
    psi_norm: 1.0,
    K_strength: 0.8,
    
    // G(x,t) parameters
    m: 1.0,
    c: 1.0,
    v_ratio: 0.2,
    phi_grav: -1e-9,
    
    // Simulation parameters
    x: 1.0,
    t_max: 10.0
  });

  const PHI = (1 + Math.sqrt(5)) / 2;

  // Calculate individual terms
  const calculateH = (t) => {
    return params.R_d / params.E_s - params.C_m;
  };

  const calculateP = (t) => {
    return params.events.reduce((sum, delta_e, i) => {
      return sum + delta_e * Math.exp(-delta_e * t / params.tau_p);
    }, 0);
  };

  const calculateR = (t) => {
    // Numerical integration of U(t') * G(t') from 0 to t
    const dt = 0.1;
    let integral = 0;
    for (let t_prime = 0; t_prime <= t; t_prime += dt) {
      const U = params.U_amplitude * Math.sin(t_prime);
      integral += U * params.G_kernel * dt;
    }
    return integral;
  };

  const calculateZ = (t) => {
    // Approximation of Re[ζ(1/2 + i*ω*t)] using known behavior
    const omega_t = params.omega * t;
    // Simplified approximation - real zeta function is complex
    const zeta_approx = Math.cos(omega_t) * Math.exp(-0.1 * Math.abs(omega_t));
    return params.E_Z * zeta_approx;
  };

  const calculateQ = () => {
    // Simplified quantum correlation
    return params.hbar * params.psi_norm * params.K_strength;
  };

  const calculateG = () => {
    const v_c_ratio = params.v_ratio;
    const gamma = 1 / Math.sqrt(1 - v_c_ratio * v_c_ratio);
    const grav_factor = Math.sqrt(1 + 2 * params.phi_grav / (params.c * params.c));
    return params.m * params.c * params.c * gamma / grav_factor;
  };

  const calculateTotalEnergy = (t) => {
    const H = calculateH(t);
    const P = calculateP(t);
    const R = calculateR(t);
    const Z = calculateZ(t);
    const Q = calculateQ();
    const G = calculateG();
    
    return PHI * (H + P + R + Z + Q + G);
  };

  // Generate data for visualization
  const generateData = () => {
    const data = [];
    const steps = 100;
    const dt = params.t_max / steps;
    
    for (let i = 0; i <= steps; i++) {
      const t = i * dt;
      data.push({
        t: t,
        H: calculateH(t),
        P: calculateP(t),
        R: calculateR(t),
        Z: calculateZ(t),
        Q: calculateQ(),
        G: calculateG(),
        Total: calculateTotalEnergy(t)
      });
    }
    return data;
  };

  const [data, setData] = useState([]);
  const [analysis, setAnalysis] = useState({});

  useEffect(() => {
    const newData = generateData();
    setData(newData);
    
    // Analyze contributions at final time
    const finalT = params.t_max;
    const terms = {
      H: calculateH(finalT),
      P: calculateP(finalT),
      R: calculateR(finalT),
      Z: calculateZ(finalT),
      Q: calculateQ(),
      G: calculateG()
    };
    
    const totalMagnitude = Object.values(terms).reduce((sum, val) => sum + Math.abs(val), 0);
    const contributions = {};
    Object.entries(terms).forEach(([key, val]) => {
      contributions[key] = (Math.abs(val) / totalMagnitude * 100).toFixed(1);
    });
    
    const dominantTerm = Object.entries(terms).reduce((max, [key, val]) => 
      Math.abs(val) > Math.abs(max[1]) ? [key, val] : max
    );
    
    setAnalysis({
      terms,
      contributions,
      dominantTerm,
      totalEnergy: calculateTotalEnergy(finalT),
      phi: PHI
    });
  }, [params]);

  const handleParamChange = (param, value) => {
    setParams(prev => ({
      ...prev,
      [param]: parseFloat(value) || 0
    }));
  };

  const contributionData = analysis.contributions ? 
    Object.entries(analysis.contributions).map(([term, percentage]) => ({
      term,
      percentage: parseFloat(percentage),
      value: analysis.terms[term]
    })) : [];

  return (
    <div className="w-full max-w-7xl mx-auto p-6 space-y-6">
      <div className="text-center mb-8">
        <h1 className="text-3xl font-bold text-blue-600 mb-2">EternaFX Reasoner</h1>
        <p className="text-gray-600">Unified Energy Functional Analysis & Optimization</p>
        <div className="text-lg font-mono bg-gray-100 p-2 rounded mt-4">
          E(x,t) = Φ · [H + P + R + Z + Q + G] where Φ = {PHI.toFixed(6)}
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        {/* Parameter Control Panel */}
        <div className="lg:col-span-1 space-y-4">
          <div className="bg-white rounded-lg shadow-lg p-4">
            <h2 className="text-xl font-semibold mb-4 flex items-center">
              <Calculator className="mr-2" /> Parameters
            </h2>
            
            {/* H(x,t) Controls */}
            <div className="mb-4 p-3 bg-red-50 rounded">
              <h3 className="font-semibold text-red-700 mb-2">H(x,t): Regulatory Balance</h3>
              <div className="space-y-2">
                <div>
                  <label className="block text-sm">R_d (Regulatory Drive):</label>
                  <input 
                    type="number" 
                    step="0.1" 
                    value={params.R_d}
                    onChange={e => handleParamChange('R_d', e.target.value)}
                    className="w-full p-1 border rounded"
                  />
                </div>
                <div>
                  <label className="block text-sm">E_s (Societal Readiness):</label>
                  <input 
                    type="number" 
                    step="0.1" 
                    value={params.E_s}
                    onChange={e => handleParamChange('E_s', e.target.value)}
                    className="w-full p-1 border rounded"
                  />
                </div>
                <div>
                  <label className="block text-sm">C_m (Cost):</label>
                  <input 
                    type="number" 
                    step="0.1" 
                    value={params.C_m}
                    onChange={e => handleParamChange('C_m', e.target.value)}
                    className="w-full p-1 border rounded"
                  />
                </div>
              </div>
            </div>

            {/* P(x,t) Controls */}
            <div className="mb-4 p-3 bg-orange-50 rounded">
              <h3 className="font-semibold text-orange-700 mb-2">P(x,t): Discrete Events</h3>
              <div>
                <label className="block text-sm">τ_p (Decay Time):</label>
                <input 
                  type="number" 
                  step="0.1" 
                  value={params.tau_p}
                  onChange={e => handleParamChange('tau_p', e.target.value)}
                  className="w-full p-1 border rounded"
                />
              </div>
            </div>

            {/* Z(x,t) Controls */}
            <div className="mb-4 p-3 bg-purple-50 rounded">
              <h3 className="font-semibold text-purple-700 mb-2">Z(x,t): Spectral Resonance</h3>
              <div className="space-y-2">
                <div>
                  <label className="block text-sm">ω (Frequency):</label>
                  <input 
                    type="number" 
                    step="0.01" 
                    value={params.omega}
                    onChange={e => handleParamChange('omega', e.target.value)}
                    className="w-full p-1 border rounded"
                  />
                </div>
                <div>
                  <label className="block text-sm">E_Z (Amplitude):</label>
                  <input 
                    type="number" 
                    step="0.1" 
                    value={params.E_Z}
                    onChange={e => handleParamChange('E_Z', e.target.value)}
                    className="w-full p-1 border rounded"
                  />
                </div>
              </div>
            </div>

            {/* Time Control */}
            <div className="mb-4 p-3 bg-gray-50 rounded">
              <h3 className="font-semibold mb-2">Simulation</h3>
              <div>
                <label className="block text-sm">t_max:</label>
                <input 
                  type="number" 
                  step="1" 
                  value={params.t_max}
                  onChange={e => handleParamChange('t_max', e.target.value)}
                  className="w-full p-1 border rounded"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Visualization Panel */}
        <div className="lg:col-span-2 space-y-4">
          
          {/* Energy Evolution Chart */}
          <div className="bg-white rounded-lg shadow-lg p-4">
            <h2 className="text-xl font-semibold mb-4 flex items-center">
              <TrendingUp className="mr-2" /> Energy Evolution
            </h2>
            <ResponsiveContainer width="100%" height={300}>
              <LineChart data={data}>
                <CartesianGrid strokeDasharray="3,3" />
                <XAxis dataKey="t" />
                <YAxis />
                <Tooltip />
                <Legend />
                <Line type="monotone" dataKey="Total" stroke="#2563eb" strokeWidth={3} name="Total E(x,t)" />
                <Line type="monotone" dataKey="H" stroke="#dc2626" strokeWidth={2} name="H(x,t)" />
                <Line type="monotone" dataKey="P" stroke="#ea580c" strokeWidth={2} name="P(x,t)" />
                <Line type="monotone" dataKey="R" stroke="#16a34a" strokeWidth={2} name="R(x,t)" />
                <Line type="monotone" dataKey="Z" stroke="#9333ea" strokeWidth={2} name="Z(x,t)" />
                <Line type="monotone" dataKey="Q" stroke="#0891b2" strokeWidth={2} name="Q(x,t)" />
                <Line type="monotone" dataKey="G" stroke="#be123c" strokeWidth={2} name="G(x,t)" />
              </LineChart>
            </ResponsiveContainer>
          </div>

          {/* Term Contributions */}
          <div className="bg-white rounded-lg shadow-lg p-4">
            <h2 className="text-xl font-semibold mb-4 flex items-center">
              <Activity className="mr-2" /> Term Contributions at t = {params.t_max}
            </h2>
            <ResponsiveContainer width="100%" height={250}>
              <BarChart data={contributionData}>
                <CartesianGrid strokeDasharray="3,3" />
                <XAxis dataKey="term" />
                <YAxis />
                <Tooltip formatter={(value, name) => [
                  `${value}%`, 
                  name === 'percentage' ? 'Contribution' : 'Value'
                ]} />
                <Bar dataKey="percentage" fill="#3b82f6" />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>
      </div>

      {/* Analysis Summary */}
      <div className="bg-white rounded-lg shadow-lg p-6">
        <h2 className="text-xl font-semibold mb-4 flex items-center">
          <Zap className="mr-2" /> EternaFX Analysis
        </h2>
        
        {analysis.totalEnergy && (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div className="bg-blue-50 p-4 rounded">
              <h3 className="font-semibold text-blue-700">Total Energy</h3>
              <p className="text-2xl font-mono">{analysis.totalEnergy.toFixed(4)}</p>
            </div>
            
            <div className="bg-green-50 p-4 rounded">
              <h3 className="font-semibold text-green-700">Dominant Term</h3>
              <p className="text-lg font-mono">{analysis.dominantTerm[0]}</p>
              <p className="text-sm">Value: {analysis.dominantTerm[1].toFixed(4)}</p>
            </div>
            
            <div className="bg-yellow-50 p-4 rounded">
              <h3 className="font-semibold text-yellow-700">Golden Ratio</h3>
              <p className="text-lg font-mono">Φ = {PHI.toFixed(6)}</p>
              <p className="text-sm">Scaling Factor</p>
            </div>
            
            <div className="bg-purple-50 p-4 rounded">
              <h3 className="font-semibold text-purple-700">Optimization</h3>
              <p className="text-sm">
                {analysis.dominantTerm[1] > 0 ? 
                  `Reduce ${analysis.dominantTerm[0]} parameters` :
                  `Increase ${analysis.dominantTerm[0]} parameters`
                }
              </p>
            </div>
          </div>
        )}

        <div className="mt-6 p-4 bg-gray-50 rounded">
          <h3 className="font-semibold mb-2">Optimization Recommendations:</h3>
          <ul className="space-y-1 text-sm">
            <li>• <strong>H(x,t) Optimization:</strong> Increase R_d or decrease C_m to improve regulatory balance</li>
            <li>• <strong>P(x,t) Optimization:</strong> Adjust τ_p to control event decay rates</li>
            <li>• <strong>Z(x,t) Optimization:</strong> Tune ω for resonance frequency matching</li>
            <li>• <strong>System Balance:</strong> Golden ratio Φ ensures optimal harmonic scaling</li>
          </ul>
        </div>
      </div>
    </div>
  );
};

export default EternaFXReasoner;
class Memory:
    """Memory system for storing and retrieving information with decay."""
    
    def __init__(self, short_term_capacity=100, long_term_threshold=5):
        self.short_term = deque(maxlen=short_term_capacity)
        self.long_term = {}
        self.short_term_capacity = short_term_capacity
        self.long_term_threshold = long_term_threshold
        self.access_counts = {}
        
    def store(self, key, value):
        """Store information in short-term memory."""
        self.short_term.append((key, value))
        if key in self.access_counts:
            self.access_counts[key] += 1
        else:
            self.access_counts[key] = 1
            
        # Move to long-term memory if accessed frequently
        if self.access_counts[key] >= self.long_term_threshold:
            self.long_term[key] = value
            
    def retrieve(self, key):
        """Retrieve information from memory."""
        # Check short-term memory first
        for k, v in self.short_term:
            if k == key:
                if key in self.access_counts:
                    self.access_counts[key] += 1
                return v
                
        # Check long-term memory
        if key in self.long_term:
            if key in self.access_counts:
                self.access_counts[key] += 1
            return self.long_term[key]
            
        return None
        
    def decay(self, rate=0.1):
        """Apply memory decay to access counts."""
        for key in self.access_counts:
            self.access_counts[key] *= (1 - rate)


class Module:
    """Base class for all modules in the EternaFX system."""
    
    def __init__(self, name="GenericModule"):
        self.name = name
        self.connections = []
        self.state = None
        self.phi_value = 0.0
        self.priority = 0.0
        self.memory = Memory()
        self.learning_rate = 0.01
        self.weights = {}
        self.input_buffer = []
        self.output_buffer = []
        
    def connect(self, other_module):
        """Connect this module to another module."""
        if other_module not in self.connections:
            self.connections.append(other_module)
            
    def disconnect(self, other_module):
        """Disconnect this module from another module."""
        if other_module in self.connections:
            self.connections.remove(other_module)
            
    def send(self, message):
        """Send a message to all connected modules."""
        for module in self.connections:
            module.receive(message, self)
            
    def receive(self, message, sender):
        """Receive a message from another module."""
        self.input_buffer.append((message, sender))
        
    def process(self, input_data):
        """Process input data. Override in derived classes."""
        self.state = input_data
        return input_data
        
    def update_phi(self, adjacency_matrix=None):
        """Update Phi value based on the module's current state."""
        if adjacency_matrix is None and hasattr(self, 'state') and isinstance(self.state, np.ndarray):
            # Use state to create simple adjacency matrix if not provided
            size = len(self.state)
            adjacency_matrix = np.zeros((size, size))
            for i in range(size):
                for j in range(size):
                    if i != j:
                        adjacency_matrix[i, j] = abs(self.state[i] - self.state[j])
                        
        if adjacency_matrix is not None:
            # Calculate Phi based on adjacency matrix
            graph = nx.from_numpy_array(adjacency_matrix)
            try:
                # Use clustering coefficient as a simple estimation of integration
                phi = nx.average_clustering(graph)
                if np.isnan(phi):
                    phi = 0.0
                self.phi_value = phi
            except:
                self.phi_value = 0.0
        
        return self.phi_value
        
    def adapt(self):
        """Adapt module connectivity based on information flow."""
        # Override in specific implementations
        pass
        
    def learn(self, input_data, target_output):
        """Simple learning mechanism."""
        output = self.process(input_data)
        error = target_output - output
        
        # Update weights based on error
        for key in self.weights:
            self.weights[key] += self.learning_rate * error * input_data
            
        return error



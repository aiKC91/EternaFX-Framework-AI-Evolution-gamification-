# ------------------------------------------------------------
# 6. Boundary Error Handler (BEH)
# ------------------------------------------------------------
class BoundaryErrorHandler:
    def __init__(self, core_principles):
        self.core_principles = core_principles
        logger.info(f"BEH initialized with core_principles={self.core_principles}")

    def validate_output(self, ai_output):
        """
        Checks whether the AI output reflects core principles.
        If a principle is missing, a warning is appended.
        """
        try:
            for principle in self.core_principles:
                if principle.lower() not in ai_output.lower():
                    logger.warning(f"Output may not fully reflect the core principle '{principle}'.")
                    return f"WARNING: Output may not fully reflect the core principle '{principle}'."
            return ai_output
        except Exception as e:
            logger.error(f"Error in output validation: {e}")
            return f"Error validating output: {e}"

# ------------------------------------------------------------
# 7. EternaFX Entity (Integration Layer)
# ------------------------------------------------------------
class EternaFXEntity:
    def __init__(self, config):
        try:
            self.CEM = CognitiveEmulationModule(
                problem_space=config["cem"]["problem_space"],
                deduction_method=config["cem"]["deduction_method"]
            )
            self.PPE = PersonalityPreservationEngine(
                tone_style=config["ppe"]["tone_style"],
                response_flavor=config["ppe"]["response_flavor"]
            )
            self.MSN = MemoryStreamNetwork()
            self.RDM = ReactiveDecisionMatrix(
                reaction_style=config["rdm"]["reaction_style"]
            )
            self.CFE = CreativeFlowEngine(
                creative_source=config["cfe"]["creative_source"]
            )
            self.BEH = BoundaryErrorHandler(
                core_principles=config["beh"]["core_principles"]
            )
            logger.info("EternaFXEntity initialized successfully.")
        except Exception as e:
            logger.critical(f"Failed to initialize EternaFXEntity: {e}")
            sys.exit(1)

    def process_input(self, input_data):
        """
        Processes the input through multiple stages:
          1. Cognitive processing to generate a thought.
          2. Logs the thought into memory.
          3. Generates a personality-driven response.
          4. Validates the response against core values.
          5. Generates an immediate reaction.
          6. Optionally produces a creative solution.
          7. Provides a summary of recent memories.
        """
        try:
            # 1. Cognitive processing
            thought = self.CEM.process_thought(input_data)
            self.MSN.log_memory(thought)
            
            # 2. Generate a personality-infused response
            raw_response = self.PPE.generate_response(thought)
            validated_response = self.BEH.validate_output(raw_response)
            
            # 3. Generate a reactive decision
            reaction = self.RDM.generate_reaction(input_data)
            
            # 4. Optionally generate a creative solution for additional insight
            creative_solution = self.CFE.generate_solution(input_data)
            
            return {
                "thought": thought,
                "response": validated_response,
                "reaction": reaction,
                "creative_solution": creative_solution,
                "memory_summary": self.MSN.summarize_memory()
            }
        except Exception as e:
            logger.error(f"Error processing input: {e}")
            return {"error": f"Error processing input: {e}"}

# ------------------------------------------------------------
# Main Execution: Interactive Loop
# ------------------------------------------------------------
def main():
    ai_entity = EternaFXEntity(CONFIG)
    print("Welcome to EternaFX Core - Your Personal Digital Brain (Casey/Kc/Cece Clark)")
    
    while True:
        try:
            user_input = input("\nEnter your query or thought (type 'exit' to quit): ")
            if user_input.lower() == "exit":
                print("Goodbye! Keep growing and keep pushing forward.")
                break
            
            # Process the user input through the integrated EternaFX entity
            output = ai_entity.process_input(user_input)
            
            print("\n--- EternaFX Entity Output ---")
            print(f"Thought: {output.get('thought', 'N/A')}")
            print(f"Response: {output.get('response', 'N/A')}")
            print(f"Reaction: {output.get('reaction', 'N/A')}")
            print(f"Creative Solution: {output.get('creative_solution', 'N/A')}")
            print(f"Recent Memory: {output.get('memory_summary', 'N/A')}")

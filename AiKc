# ------------------------------------------------------------
# 3. Memory Stream Network (MSN) with Semantic Memory
# ------------------------------------------------------------
class MemoryStreamNetwork:
    def __init__(self):
        # Each memory is stored as a dict with content and metadata.
        self.memory = []
        logger.info("MSN initialized.")

    def log_memory(self, thought):
        """Stores a new thought along with a timestamp."""
        try:
            entry = {
                "timestamp": datetime.datetime.now().isoformat(),
                "content": thought
                # Future enhancement: Add semantic tags or context.
            }
            self.memory.append(entry)
            logger.debug(f"Logged memory: {entry}")
        except Exception as e:
            logger.error(f"Error logging memory: {e}")

    def recall_memory(self, count=5):
        """Recalls the last 'count' memories."""
        try:
            return self.memory[-count:] if len(self.memory) >= count else self.memory
        except Exception as e:
            logger.error(f"Error recalling memory: {e}")
            return []

    def summarize_memory(self):
        """Creates a summary of recent memories for contextual continuity."""
        try:
            recalled = self.recall_memory()
            summary = " | ".join(f"{m['timestamp']}: {m['content']}" for m in recalled)
            return summary
        except Exception as e:
            logger.error(f"Error summarizing memory: {e}")
            return ""


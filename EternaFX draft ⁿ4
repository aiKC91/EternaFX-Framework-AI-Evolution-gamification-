# --- Scenario Generation with Golden Ratio ---

def calculate_scenario_complexity(base_complexity: float, level: int) -> float:
    """
    Calculates scenario complexity based on the Golden Ratio and user level.

    Args:
        base_complexity: The base complexity of the initial scenario.
        level: The user's current level.

    Returns:
        The calculated scenario complexity.
    """
    golden_ratio = (1 + math.sqrt(5)) / 2
    complexity = base_complexity * (golden_ratio ** level)
    return complexity


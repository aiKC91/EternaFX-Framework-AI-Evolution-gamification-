class ResourceManagement(Subsystem):
    """
    Subsystem for managing resources within the simulation.
    """

    def __init__(self, name, config, db):
        super().__init__(name, config, db)
        self.resource_levels = {
            "energy": self.get_config("initial_energy", 1000),
            "materials": self.get_config("initial_materials", 500),
            "population": self.get_config("initial_population", 1000000),
        }
        self.consumption_rate = self.get_config("consumption_rate", 0.01)
        self.production_rate = self.get_config("production_rate", 0.005)

    def update(self):
        try:
            # Resource Consumption
            for resource in self.resource_levels:
                self.resource_levels[resource] -= (
                    self.resource_levels[resource] * self.consumption_rate
                )

            # Resource Production (example - very basic)
            self.resource_levels["energy"] += (
                self.resource_levels["energy"] * self.production_rate
            )

            # Ensure resources don't go below zero
            for resource in self.resource_levels:
                self.resource_levels[resource] = max(0, self.resource_levels[resource])

            self.update_state(
                status="managing resources",
                message=f"Energy: {self.resource_levels['energy']:.2f}, Materials: {self.resource_levels['materials']:.2f}, Population: {self.resource_levels['population']:.2f}",
            )
            self.log_history({"resources": self.resource_levels})

        except Exception as e:
            logger.error(f"Error in ResourceManagement subsystem: {e}")
            self.update_state(status="error", message=str(e))


from sympy import isprime  # Miller-Rabin implementation

class AdvancedPrimeGapAnalyzer(PrimeGapAnalyzer):
    def calculate_large_gaps(self, start, end, chunk_size=1e6):
        """Segmented sieve for large prime ranges"""
        primes = []
        for chunk in range(int(start), int(end), int(chunk_size)):
            # Use probabilistic testing for large numbers
            if chunk > 1e8:
                primes.extend([n for n in range(chunk, chunk+chunk_size) 
                             if isprime(n)])
            else:
                primes.extend(self.sieve_segment(chunk, chunk+chunk_size))
        return self._analyze_gaps(primes)

    def sieve_segment(self, start, end):
        """Segmented Sieve of Eratosthenes"""
        # Implementation from https://github.com/kimwalisch/primesieve
        return primesieve.primes(start, end)

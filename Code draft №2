# -----------------------------
# 9. Cognitive Architecture: Dynamic Priority Engine
# -----------------------------
class DynamicPriorityEngine(nn.Module):
    def __init__(self, input_dim=10):
        super().__init__()
        self.phi_network = nn.Sequential(
            nn.Linear(input_dim, 32),
            nn.GELU(),
            nn.Linear(32, 2)
        )

    def forward(self, problem_features):
        weights = torch.softmax(self.phi_network(problem_features), dim=-1)
        return 0.6 * weights[:, 0] + 0.4 * weights[:, 1]

def rank_problems(problem_set):
    feature_matrix = torch.randn(len(problem_set), 10)
    engine = DynamicPriorityEngine()
    priority_scores = engine(feature_matrix)
    ranked = sorted(zip(problem_set, priority_scores.tolist()), key=lambda x: -x[1])
    return ranked


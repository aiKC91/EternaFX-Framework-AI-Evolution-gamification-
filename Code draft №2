class XPChaosLegacySystem:
    def __init__(self, xp, chaos, legacy):
        self.xp = xp
        self.chaos = chaos
        self.legacy = legacy

    def gain_xp(self, amount):
        """Increase XP by a specified amount."""
        self.xp += amount

    def apply_penalties(self):
        """Apply XP penalties if chaos is too high."""
        if self.chaos > 50:
            self.xp -= 10


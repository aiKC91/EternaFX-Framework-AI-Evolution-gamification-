        Compute Global Impact Index:
            I = PHI * sqrt((1/n) * Σ (T_i - T_mean)^2)
        """
        n = len(trade_changes)
        T_mean = np.mean(trade_changes)
        variance = np.mean([(T - T_mean)**2 for T in trade_changes])
        I = PHI * math.sqrt(variance)
        return I


import math
import numpy as np

# Define global constant (Golden Ratio)
PHI = (1 + math.sqrt(5)) / 2  # ~1.618

# -------------------------------
# Module 1: Ada Lovelace AI
# -------------------------------
class AdaLovelaceAI:
    def generate_scenario(self, tariff_rate: float) -> dict:
        """
        Generate a scenario with a complexity based on tariff_rate.
        Equation:
            SC = SC0 * PHI * ((1 + δ) / (1 + τ))
        """
        SC0 = 10.0  # Base complexity
        delta = 0.2  # Domestic growth factor
        tau = tariff_rate  # Tariff rate input
        scenario_complexity = SC0 * PHI * ((1 + delta) / (1 + tau))
        scenario = {
            "title": "Quantum Bridge to Birch–Swinnerton-Dyer",
            "tariff_rate": tariff_rate,
            "complexity": scenario_complexity,
            "description": "A scenario exploring advanced number theory, quantum entanglement, and ethical trade impacts."
        }
        return scenario

# -------------------------------
# Module 2: Alan Turing AI
# -------------------------------
class AlanTuringAI:
    def optimize_tariff(self, target_flows: list, model_flows: list) -> float:
        """
        Optimize tariff rate τ* to minimize error:
            J(τ) = (1/n) * Σ|T_target - f(τ)|^2
        Returns an approximate optimal tariff rate.
        (Here, we simulate optimization by choosing the tariff that minimizes squared error.)
        """
        n = len(target_flows)
        best_tau = None
        best_error = float('inf')
        # Assume tariff_rate candidates between 0.0 and 1.0 in steps of 0.1
        for tau in np.arange(0, 1.1, 0.1):
            errors = [(target - (model * (1 - tau)))**2 for target, model in zip(target_flows, model_flows)]
            error = sum(errors) / n
            if error < best_error:
                best_error = error
                best_tau = tau
        return best_tau

# -------------------------------
# Module 3: Marie Curie AI
# -------------------------------
class MarieCurieAI:
    def assess_ethics(self, scenario: dict, tariff_rate: float) -> float:
        """
        Compute ethical impact score:
            E = B / (1 + λ (τ - τ_opt)^2)
        For simplicity, we use:
            B = 1.6, τ_opt = 0.3, λ = 5.0
        """
        B = 1.6
        tau_opt = 0.3
        lambda_param = 5.0
        tau = tariff_rate
        ethical_score = B / (1 + lambda_param * (tau - tau_opt)**2)
        return ethical_score


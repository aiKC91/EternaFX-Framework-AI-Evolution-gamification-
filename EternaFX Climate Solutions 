def sample_model_fn_climate(inputs: Dict) -> Dict:
    region_factor = inputs.get("region_factor", 1.0)
    return {
        "renewable_share": (0.4 + 0.3 * np.random.random()) * region_factor,
        "emission_reduction": 0.5 + 0.4 * np.random.random(),
        "conservation_index": 0.6 + 0.3 * np.random.random()
    }

def sample_cost_fn_climate(output: Dict) -> float:
    return 0.1 + 0.2 * np.random.random()

def sample_sustainability_eval(output: Dict) -> (float, float):
    factors = [
        output.get("renewable_share", 0.5),
        output.get("emission_reduction", 0.5),
        output.get("conservation_index", 0.5)
    ]
    weights = [0.4, 0.35, 0.25]
    score = sum(w * f for w, f in zip(weights, factors))
    uncertainty = np.std(factors)  # Dummy uncertainty calculation
    return score, uncertainty

def demo_climate_eternafx_enhanced():
    agents = [
        AIAgent(f"Agent_{i}", sample_model_fn_climate, sample_cost_fn_climate, sample_sustainability_eval)
        for i in range(3)
    ]
    
    climate_fx = ClimateEternaFX(
        agents=agents,
        compute_budget=1.0,
        beta=3.0,
        combination_weights=[0.25, 0.20, 0.15, 0.15, 0.10, 0.10, 0.05],
        quantum_enabled=True
    )
    
    results = []
    for t in tqdm(range(20)):
        input_data = {
            "renewable_share": 0.5 + 0.5 * np.random.random(),
            "emission_reduction": 0.6 + 0.4 * np.random.random(),
            "conservation_index": 0.7 + 0.3 * np.random.random(),
            "extreme_events": 0.2 + 0.3 * np.random.random(),

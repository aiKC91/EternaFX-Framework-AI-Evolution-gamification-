class MathematicalVisualizer:
    """Visualizer for complex mathematical structures."""
    
    def __init__(self, config: Dict[str, Any]):
        self.logger = logging.getLogger('MathViz')
        self.zeros_count = config.get('zeta_zeros_count', 30)
        
    def visualize_zeta_function(self):
        """Create 3D visualization of Riemann Zeta function."""
        self.logger.info("Generating Zeta function visualization...")
        
        try:
            real_values = np.linspace(0, 1, 100)
            imag_values = np.linspace(0, 50, 100)
            real_grid, imag_grid = np.meshgrid(real_values, imag_values)
            
            zeta_values = np.zeros_like(real_grid)
            for i in range(real_grid.shape[0]):
                for j in range(real_grid.shape[1]):
                    s = complex(real_grid[i, j], imag_grid[i, j])
                    try:
                        zeta_values[i, j] = abs(mpmath.zeta(s))
                    except:
                        zeta_values[i, j] = 0
            
            critical_line = np.ones_like(imag_values) * 0.5
            
            fig = go.Figure()
            fig.add_trace(go.Surface(
                x=real_values, y=imag_values, z=zeta_values.T,
                colorscale="Viridis", opacity=0.8, name="|ζ(s)|"
            ))
            fig.add_trace(go.Scatter3d(
                x=critical_line, y=imag_values, z=np.zeros_like(imag_values),
                mode='lines', line=dict(color='red', width=5),
                name="Critical Line (Re=0.5)"
            ))
            
            fig.update_layout(
                title="Riemann Zeta Function (EternaFX Imagine)",
                scene=dict(
                    xaxis_title="Re(s)", yaxis_title="Im(s)", zaxis_title="|ζ(s)|",
                    camera=dict(eye=dict(x=1.5, y=1.5, z=0.8))
                ),
                height=800, margin=dict(l=0, r=0, t=80, b=0)
            )
            
            return fig
        except Exception as e:
            self.logger.error(f"Error in visualize_zeta_function: {e}")
            return None
    
    def visualize_complex_plane(self, func, x_range=(-3, 3), y_range=(-3, 3), res=200):
        """Visualize complex function on complex plane."""
        self.logger.info("Generating complex plane visualization...")
        
        try:
            x = np.linspace(x_range[0], x_range[1], res)
            y = np.linspace(y_range[0], y_range[1], res)
            X, Y = np.meshgrid(x, y)
            Z = X + 1j*Y
            
            F = np.vectorize(func)(Z)
            magnitude = np.abs(F)
            phase = np.angle(F)
            
            fig = make_subplots(
                rows=1, cols=2,
                subplot_titles=("Magnitude", "Phase"),
                specs=[[{'type': 'surface'}, {'type': 'surface'}]]
            )
            
            fig.add_trace(go.Surface(
                x=X, y=Y, z=magnitude,
                colorscale="Viridis", showscale=True, name="Magnitude"
            ), row=1, col=1)
            
            fig.add_trace(go.Surface(
                x=X, y=Y, z=phase,
                surfacecolor=phase, colorscale="hsv",
                cmin=-np.pi, cmax=np.pi,
                colorbar=dict(tickvals=[-np.pi, 0, np.pi], ticktext=['-π', '0', 'π']),
                name="Phase"
            ), row=1, col=2)
            
            fig.update_layout(
                title=f"Complex Function Visualization: {func.__name__}",
                scene1=dict(
                    xaxis_title="Re(z)", yaxis_title="Im(z)", zaxis_title="|f(z)|",
                    aspectmode="cube"
                ),
                scene2=dict(
                    xaxis_title="Re(z)", yaxis_title="Im(z)", zaxis_title="arg(f(z))",
                    aspectmode="cube"
                ),
                height=600
            )
            
            return fig
        except Exception as e:
            self.logger.error(f"Error in visualize_complex_plane: {e}")
            return None


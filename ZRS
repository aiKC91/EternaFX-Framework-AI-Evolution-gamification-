class ConservationLawDiscoverer(nn.Module):
    """Neural network for discovering conserved quantities."""
    
    def __init__(self, config: Dict[str, Any]):
        super().__init__()
        self.logger = logging.getLogger('ConservationLaw')
        self.input_size = config.get('input_size', 3)
        self.hidden_size = config.get('hidden_size', 20)
        self.output_size = config.get('output_size', 1)
        self.net = nn.Sequential(
            nn.Linear(self.input_size, self.hidden_size),
            nn.Tanh(),
            nn.Linear(self.hidden_size, self.hidden_size),
            nn.Tanh(),
            nn.Linear(self.hidden_size, self.output_size)
        )
        
    def forward(self, x):
        return self.net(x)
    
    def train_model(self, simulation_data, config: Dict[str, Any]):
        """Train to find conserved quantities."""
        try:
            t, ω, H, E = simulation_data
            X = np.column_stack((ω, H, E))
            y = np.zeros(len(t))
            
            X_tensor = torch.tensor(X, dtype=torch.float32)
            y_tensor = torch.tensor(y, dtype=torch.float32)
            
            optimizer = torch.optim.Adam(self.parameters(), lr=config.get('learning_rate', 0.01))
            criterion = nn.MSELoss()
            
            for epoch in range(config.get('training_epochs', 2000)):
                optimizer.zero_grad()
                outputs = self(X_tensor)
                loss = criterion(outputs.squeeze(), y_tensor)
                loss.backward()
                optimizer.step()
                
                if epoch % 100 == 0:
                    self.logger.info(f"Epoch {epoch}: Loss = {loss.item():.6f}")
            
            with torch.no_grad():
                conserved = self(X_tensor).numpy()
            
            return conserved.flatten()
        except Exception as e:
            self.logger.error(f"Error in train_model: {e}")
            return None


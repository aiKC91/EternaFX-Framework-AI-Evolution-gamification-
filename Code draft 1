# --- Helper Functions ---

def get_db() -> Generator[Session, None, None]:
    """Dependency to get a database session."""
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

def verify_password(plain_password: str, hashed_password: str) -> bool:
    """Verify plain password against hashed password."""
    return pwd_context.verify(plain_password, hashed_password)

def get_password_hash(password: str) -> str:
    """Get hash for password."""
    return pwd_context.hash(password)

def create_access_token(data: dict, expires_delta: Optional[timedelta] = None) -> str:
    """Create JWT access token."""
    to_encode = data.copy()
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)
    to_encode.update({"exp": expire})
    encoded_jwt = jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)
    return encoded_jwt

def get_current_user(token: str = Depends(oauth2_scheme), db: Session = Depends(get_db)) -> User:
    """Get current user from JWT token."""
    credentials_exception = HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Could not validate credentials",
        headers={"WWW-Authenticate": "Bearer"},
    )
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        username: str = payload.get("sub")
        if username is None:
            raise credentials_exception
        token_data = {"username": username}
    except jwt.JWTError:
        raise credentials_exception
    user = db.query(User).filter(User.username == username).first()
    if user is None:
        raise credentials_exception
    return user

# --- Calculation Helper Functions ---

def calculate_xp_gain(level: int, base_xp: float = 100.0) -> float:
    """Calculate XP gain dynamically using PHI."""
    return base_xp * (PHI ** level)

def calculate_xp_cost(level: int, base_cost: float = 50.0) -> float:
    """Calculate XP cost using PHI."""
    return base_cost * (PHI ** (level - 1))

def calculate_reward(level: int, base_reward: float = 10.0, multiplier: float = 1.0) -> float:
    """Calculate rewards using PHI."""
    return base_reward * multiplier * (PHI ** (level / 2))

def calculate_complexity_penalty(level: int, base_complexity: float = 10.0) -> float:
    """Calculate complexity penalty for higher levels."""
    penalty = base_complexity / (PHI ** (level / 2))
    return max(penalty, 0.01)  # Ensure penalty doesn't go below a minimum value

def calculate_phi_bonus(level: int, base_bonus: float = 5.0, multiplier: float = 2.0) -> float:
    """Calculate milestone bonus rewards using PHI."""
    return base_bonus * (PHI ** (level / 3)) * multiplier

def calculate_scaled_penalty(level: int, base_penalty: float = 10.0) -> float:
    """Calculate penalties that decrease exponentially."""
    return base_penalty / (PHI ** (level / 3))

def calculate_milestone_phi_reward(level: int, milestone_interval: int = 5) -> float:
    """Calculate special milestone rewards."""
    if level % milestone_interval == 0:
        return (10.0 * PHI ** level) * 1.5  # Assuming base reward is 10
    return 0.0

def calculate_utility(outcome_value: float, complexity: float) -> float:
    """Calculate utility based on outcome value and scaled complexity."""
    return round((outcome_value * complexity) / PHI, 3)

def scale_complexity(base_complexity: float, factor: float) -> float:
    """Scale complexity dynamically using PHI."""
    return round(base_complexity * factor * PHI, 2)

def is_balanced(utilitarian_score: float, rule_score: float) -> bool:
    """Check if the decision is balanced."""
    return abs(utilitarian_score - rule_score) <= PHI

# --- Ratio Implementations ---

class DARTOptimizer:
    """Implements DART Optimizer for asset allocation."""
    def __init__(self, initial_assets, transformation_factor=0.1, rebalancing_factor=0.2):
        self.assets = np.array(initial_assets)
        self.transformation_factor = transformation_factor
        self.rebalancing_factor = rebalancing_factor
        self.num_assets = len(initial_assets)

    def rebalance_assets(self) -> np.ndarray:
        """Rebalance assets dynamically, maintaining total at 100."""
        change = np.random.randn(self.num_assets) * self.rebalancing_factor
        new_assets = self.assets + change
        new_assets = np.clip(new_assets, 0, None)  # Only clip negatives
        # Normalize to maintain total
        total = np.sum(new_assets)
        if total > 0: # Avoid division by zero if all assets become zero
            return np.round(new_assets / total * 100, 2)
        else:
            return np.round(new_assets, 2)


    def transform_assets(self) -> np.ndarray:
        """Transform assets using the DART ratio transformation factor."""
        self.assets = self.assets * (1 + self.transformation_factor)
        return np.round(self.assets, 2)

    def optimize_allocation(self) -> np.ndarray:
        """Perform full optimization: rebalance and transform assets."""
        self.rebalance_assets()
        return self.transform_assets()

    def get_assets(self) -> np.ndarray:
        """Return the current state of assets."""
        return self.assets

class YangMillsRatio:
    """Implements Yang-Mills Ratio for agent interaction."""
    def __init__(self, coupling_constant=1.0):
        self.coupling_constant = coupling_constant  # Example of coupling constant from Yang-Mills theory

    def calculate_interaction(self, agent1: Agent, agent2: Agent) -> float:
        """Calculate interaction between two agents using Yang-Mills ratio."""
        interaction_strength = self.coupling_constant * np.random.randn()  # Simulating random interaction
        return interaction_strength

class PvsNRatio:
    """Implements P vs NP Ratio for problem-solving complexity."""
    def __init__(self):
        self.p = 1  # Represents polynomial time complexity
        self.np = 2  # Non-deterministic polynomial time complexity

    def solve_problem(self, problem_complexity: str) -> int:
        """Solve the problem based on the P vs NP ratio."""
        if problem_complexity == "hard":
            return self.np
        return self.p

class GoldenRatio:
    """Implements Golden Ratio application."""
    def __init__(self):
        self.phi = PHI  # Golden Ratio constant

    def apply_golden_ratio(self, value: float) -> float:
        """Apply the Golden Ratio to scale a value."""
        return value * self.phi

